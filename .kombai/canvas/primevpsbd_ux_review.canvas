      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n:root{\n  --page:#ffffff; --surface:#f8fafc; --surface-2:#f1f5f9;\n  --ink:#0b1220; --ink-2:#141c2e; --ink-line:rgba(255,255,255,.10);\n  --border:#e2e8f0; --border-soft:#eef2f7; --border-strong:#cbd5e1;\n  --text:#0f172a; --muted:#64748b; --muted-2:#94a3b8;\n  --accent:#2563eb; --accent-hover:#1d4ed8; --accent-subtle:#eff6ff; --accent-line:#c7d9fd; --accent-wash:#f6f9ff;\n  --success:#047857; --success-bg:#ecfdf5; --warning:#b45309; --warning-bg:#fffbeb; --danger:#b91c1c;\n  --r-card:16px; --r-ctl:10px;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:#fff;color:var(--text);font-family:'Inter',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}\na{color:inherit;text-decoration:none}\nbutton{font:inherit;color:inherit;background:none;border:0;cursor:pointer}\ninput{font:inherit;color:inherit}\ni[class^=\"icon-\"]{font-size:15px;line-height:1;display:inline-block;vertical-align:-2px}\n.display{font-family:'Plus Jakarta Sans','Inter',sans-serif;letter-spacing:-.025em}\n.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;letter-spacing:-.01em}\n.wrap{max-width:1320px;margin:0 auto;padding:0 32px}\n\n/* header */\n.hdr{background:#fff;border-bottom:1px solid var(--border)}\n.hdr-in{display:flex;align-items:center;justify-content:space-between;height:64px;gap:24px}\n.hdr-left{display:flex;align-items:center;gap:30px}\n.brand{font-family:'Plus Jakarta Sans',sans-serif;font-size:19px;font-weight:800;letter-spacing:-.035em}\n.nav{display:flex;gap:2px}\n.nav a{display:flex;align-items:center;gap:5px;padding:7px 10px;border-radius:8px;font-size:13.5px;font-weight:500;color:#334155}\n.nav a i{font-size:13px;color:var(--muted-2)}\n.hdr-right{display:flex;align-items:center;gap:12px}\n.pill-ok{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;color:var(--success);background:var(--success-bg);border:1px solid #d1fae5;border-radius:999px;padding:4px 10px 4px 8px}\n.dot{width:6px;height:6px;border-radius:50%;background:#10b981;flex:none}\n.hdr-call{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:#334155}\n.hdr-call i{color:var(--muted-2)}\n.lang{border:1px solid var(--border);border-radius:8px;padding:4px 8px;font-size:12px;color:#334155;background:#fff}\n.cur{display:inline-flex;border:1px solid var(--border);border-radius:8px;overflow:hidden;font-size:12px}\n.cur b{background:var(--accent);color:#fff;padding:4px 8px;font-weight:500}\n.cur span{padding:4px 8px;color:var(--muted)}\n.signin{font-size:13px;font-weight:500;color:#334155}\n.hdr-btn{background:var(--ink);color:#fff;font-size:13px;font-weight:600;padding:8px 14px;border-radius:9px}\n\n/* title band */\n.band{border-bottom:1px solid var(--border);background:linear-gradient(180deg,#fafcff 0%,#ffffff 100%)}\n.band-in{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;padding:26px 0 24px}\n.crumb{font-size:12px;color:var(--muted-2)}\n.crumb span{color:var(--muted)}\nh1{font-family:'Plus Jakarta Sans',sans-serif;font-size:30px;font-weight:800;letter-spacing:-.03em;margin:6px 0 6px}\n.band p{font-size:13.5px;color:var(--muted);max-width:620px}\n.band-right{display:flex;align-items:center;gap:10px;flex:none}\n.wa{display:inline-flex;align-items:center;gap:8px;border:1px solid #d1fae5;background:var(--success-bg);color:var(--success);font-size:12.5px;font-weight:600;padding:8px 12px;border-radius:10px}\n.lc{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border);font-size:12.5px;font-weight:500;color:#334155;padding:8px 12px;border-radius:10px;background:#fff}\n\n/* body */\n.body{padding:22px 0 56px}\n.layout{display:grid;grid-template-columns:minmax(0,1fr) 404px;gap:24px;align-items:start}\n\n/* config strip */\n.cfg{display:flex;align-items:center;gap:26px;padding:12px 16px;border:1px solid var(--border);border-radius:14px;background:#fff;margin-bottom:12px;flex-wrap:wrap}\n.cfg-lab{font-size:11.5px;font-weight:600;color:var(--muted);letter-spacing:.03em;text-transform:uppercase;margin-right:10px}\n.seg{display:inline-flex;background:var(--surface-2);border-radius:9px;padding:3px;gap:2px}\n.seg button{padding:5px 11px;border-radius:7px;font-size:12.5px;font-weight:500;color:#475569;white-space:nowrap}\n.seg button.on{background:#fff;color:var(--text);font-weight:600;box-shadow:0 1px 2px rgba(15,23,42,.14)}\n.seg button em{font-style:normal;color:var(--success);font-size:11.5px;margin-left:4px}\n.chips{display:flex;gap:6px;flex-wrap:wrap}\n.chip{padding:5px 11px;border:1px solid var(--border);border-radius:999px;font-size:12.5px;color:#334155;background:#fff}\n.chip.on{background:var(--accent-subtle);border-color:var(--accent-line);color:var(--accent-hover);font-weight:600}\n\n/* definition band */\n.defs{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:14px}\n.defs>div{background:#fff;padding:13px 16px}\n.defs h3{font-size:13px;font-weight:600;display:flex;align-items:center;gap:7px}\n.defs h3 i{color:var(--accent);font-size:14px}\n.defs p{font-size:12.5px;color:var(--muted);margin-top:4px;line-height:1.45}\n.defs .pr{font-family:'JetBrains Mono',monospace;font-size:12px;color:#334155;margin-top:6px}\n\n/* matrix */\n.mx-wrap{border:1px solid var(--border);border-radius:var(--r-card);overflow:hidden;background:#fff}\ntable.mx{width:100%;border-collapse:collapse}\ncol.lab{width:196px}\ncol.hl{background:var(--accent-wash)}\n.mx th,.mx td{padding:10px 16px;text-align:left;vertical-align:middle;font-size:13px;border-bottom:1px solid var(--border-soft)}\n.mx thead th{padding:14px 16px 16px;vertical-align:top;border-bottom:1px solid var(--border)}\n.mx thead th.on{box-shadow:inset 0 2px 0 var(--accent)}\n.mx tbody tr:last-child td{border-bottom:0}\n.mx td.rowlab{font-size:12.5px;color:var(--muted);font-weight:500}\n.rlab-main{display:block;color:#475569;font-weight:500}\n.rlab-sub{display:block;font-family:'JetBrains Mono',monospace;font-size:11px;color:#94a3b8;margin-top:1px}\n.ph-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}\n.stock{font-size:11px;color:var(--muted);display:inline-flex;align-items:center;gap:5px}\n.stock b{color:#334155;font-weight:500}\n.radio{width:15px;height:15px;border-radius:50%;border:1.5px solid var(--border-strong);flex:none;display:inline-block}\n.radio.on{border-color:var(--accent);background:var(--accent);box-shadow:inset 0 0 0 3px #fff}\n.pname{font-family:'Plus Jakarta Sans',sans-serif;font-size:15.5px;font-weight:700;letter-spacing:-.02em}\n.ptag{font-size:12px;color:var(--muted);margin-top:3px;line-height:1.4}\n.money{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:600;letter-spacing:-.03em}\n.money small{font-size:11px;font-weight:400;color:var(--muted-2);letter-spacing:0;margin-left:3px}\n.tick{color:var(--accent);font-size:14px;margin-right:6px;vertical-align:-2px}\n.warnv{color:var(--warning)}\n.mx tfoot td{border-top:1px solid var(--border);padding:12px 16px}\n.pick{font-size:12.5px;font-weight:600;color:var(--accent);display:inline-flex;align-items:center;gap:5px}\n.pick.sel{color:var(--muted);font-weight:500}\n.matrix-note{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);margin-top:10px}\n.matrix-note i{color:var(--success);font-size:13px}\n\n/* shared facts */\n.facts{border:1px solid var(--border);border-radius:14px;padding:6px 16px;margin-top:14px;background:#fff}\n.facts .fr{display:grid;grid-template-columns:170px 1fr;gap:16px;padding:9px 0;border-bottom:1px solid var(--border-soft);font-size:12.5px}\n.facts .fr:last-child{border-bottom:0}\n.facts .fk{color:var(--muted)}\n.facts .fv{color:#334155}\n\n/* order rail */\n.rail{position:relative}\n.order{border:1px solid var(--border);border-radius:var(--r-card);background:#fff;overflow:hidden;box-shadow:0 24px 48px -34px rgba(15,23,42,.55)}\n.order-hd{background:var(--ink);color:#fff;padding:16px 18px 18px}\n.oh-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}\n.oh-lab{font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:#8da2c2}\n.oh-term{font-family:'JetBrains Mono',monospace;font-size:11px;color:#c9d6ea;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:2px 8px}\n.oh-name{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:700;letter-spacing:-.02em}\n.oh-spec{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:#93a8c6;margin-top:4px}\n.oh-total{display:flex;align-items:baseline;gap:9px;margin-top:14px}\n.oh-total strong{font-family:'Plus Jakarta Sans',sans-serif;font-size:30px;font-weight:800;letter-spacing:-.035em}\n.oh-total span{font-size:12px;color:#93a8c6}\n.order-bd{padding:14px 18px 16px}\n.orow{margin-bottom:12px}\n.olab{display:block;font-size:11.5px;font-weight:600;color:var(--muted);margin-bottom:6px;letter-spacing:.02em}\n.seg2{display:grid;grid-template-columns:1fr 1fr;gap:6px}\n.seg2.three{grid-template-columns:repeat(3,1fr)}\n.opt{border:1px solid var(--border);border-radius:9px;padding:7px 9px;text-align:left;font-size:12px;color:#334155;background:#fff;line-height:1.3}\n.opt.on{border-color:var(--accent);background:var(--accent-subtle);color:var(--accent-hover);font-weight:600}\n.opt small{display:block;font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:400;color:var(--muted);margin-top:2px}\n.opt.on small{color:#4b7bd0}\n.opt:disabled{color:#a9b5c6;border-style:dashed;background:#fcfdff;cursor:not-allowed}\n.opt:disabled small{color:#bcc6d5}\n.hint{font-size:11.5px;color:var(--muted);margin-top:6px;line-height:1.4}\n.hr{height:1px;background:var(--border-soft);margin:14px 0}\n.sum{display:flex;align-items:center;justify-content:space-between;font-size:12.5px;color:#475569;padding:4px 0}\n.sum .v{font-family:'JetBrains Mono',monospace;color:var(--text)}\n.sum.disc .v{color:var(--success)}\n.sum.tot{border-top:1px solid var(--border);margin-top:8px;padding-top:10px;font-size:14px;font-weight:600;color:var(--text)}\n.sum.tot .v{font-size:17px;font-weight:600}\n.field{margin-top:4px}\n.field input{width:100%;height:36px;border:1px solid var(--border);border-radius:9px;padding:0 11px;font-size:12.5px;background:#fff;color:var(--text)}\n.field input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(37,99,235,.12)}\n.pay{display:grid;grid-template-columns:1fr 1fr;gap:7px}\n.paybtn{display:flex;align-items:center;gap:7px;border:1px solid var(--border);border-radius:9px;padding:8px 9px;font-size:12px;font-weight:600;color:#334155;background:#fff}\n.paybtn.on{border-color:var(--accent);background:var(--accent-subtle);color:var(--accent-hover)}\n.mk{font-family:'Plus Jakarta Sans',sans-serif;font-size:11.5px;font-weight:800;font-style:italic;letter-spacing:-.02em}\n.cta{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:44px;margin-top:12px;border-radius:10px;background:var(--accent);color:#fff;font-size:13.5px;font-weight:600;box-shadow:0 8px 18px -10px rgba(37,99,235,.9)}\n.cta i{font-size:15px}\n.cta-note{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--muted);margin-top:9px;justify-content:center}\n.cta-note i{color:var(--success);font-size:13px}\n.order-ft{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--border-soft);padding:11px 18px;font-size:12px;color:#334155;background:var(--surface)}\n.order-ft a{display:inline-flex;align-items:center;gap:5px}\n.order-ft i{color:var(--success);font-size:13px}\n.secure{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--muted);justify-content:center;margin-top:12px}\n.secure i{font-size:13px;color:var(--muted-2)}\n\n/* faq */\n.faq{margin-top:24px}\n.faq h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:16.5px;font-weight:700;letter-spacing:-.02em;margin-bottom:4px}\n.qa{border-bottom:1px solid var(--border-soft);padding:13px 0}\n.qa h4{font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:space-between;gap:12px}\n.qa h4 i{color:var(--muted-2);font-size:14px;flex:none}\n.qa p{font-size:12.5px;color:var(--muted);margin-top:5px;max-width:620px}\n\n/* footer */\n.ftr{border-top:1px solid var(--border);background:var(--surface)}\n.ftr-in{display:flex;align-items:center;justify-content:space-between;height:66px;gap:24px}\n.ftr-l{display:flex;align-items:baseline;gap:14px}\n.ftr-l .brand{font-size:15px}\n.ftr-meta{font-size:11.5px;color:var(--muted)}\n.ftr-r{display:flex;align-items:center;gap:18px;font-size:12px;color:var(--muted)}\n.ftr-r a{color:#334155}\n.ftr-r .sep{width:1px;height:14px;background:var(--border-strong)}\n</style>\n<header class=\"hdr\" data-kid=\"1\" data-name=\"site header bar\">\n<div class=\"hdr-in wrap\" data-kid=\"1-1\" data-name=\"header inner container\">\n<div class=\"hdr-left\" data-kid=\"1-1-1\" data-name=\"header left group\">\n<span class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo text\">primevpsbd</span>\n<nav class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"servers dropdown nav link\">Servers <i class=\"icon-chevron-down\" data-kid=\"1-1-1-2-1-1\" data-name=\"chevron-down dropdown icon\"></i></a>\n<a data-kid=\"1-1-1-2-2\" data-name=\"network nav link\">Network</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"tools nav link\">Tools</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"status nav link\">Status</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"docs nav link\">Docs</a>\n</nav>\n</div>\n<div class=\"hdr-right\" data-kid=\"1-1-2\" data-name=\"header right actions group\">\n<span class=\"pill-ok\" data-kid=\"1-1-2-1\" data-name=\"all-systems-status pill\"><span class=\"dot\" data-kid=\"1-1-2-1-1\" data-name=\"status indicator dot\"></span>All systems normal</span>\n<span class=\"hdr-call mono\" data-kid=\"1-1-2-2\" data-name=\"support phone number\"><i class=\"icon-phone\" data-kid=\"1-1-2-2-1\" data-name=\"phone icon\"></i>+880 9606-PRIME</span>\n<span class=\"lang mono\" data-kid=\"1-1-2-3\" data-name=\"language selector\">EN / বাংলা</span>\n<span class=\"cur mono\" data-kid=\"1-1-2-4\" data-name=\"currency toggle\"><b data-kid=\"1-1-2-4-1\" data-name=\"active BDT currency option\">৳ BDT</b><span data-kid=\"1-1-2-4-2\" data-name=\"alternative USD currency option\">$ USD</span></span>\n<span class=\"signin\" data-kid=\"1-1-2-5\" data-name=\"sign in link\">Sign in</span>\n<span class=\"hdr-btn\" data-kid=\"1-1-2-6\" data-name=\"client area button\">Client area</span>\n</div>\n</div>\n</header>\n<div class=\"band\" data-kid=\"2\" data-name=\"page title band\">\n<div class=\"band-in wrap\" data-kid=\"2-1\" data-name=\"title band inner container\">\n<div data-kid=\"2-1-1\" data-name=\"breadcrumb and heading group\">\n<div class=\"crumb mono\" data-kid=\"2-1-1-1\" data-name=\"breadcrumb trail\">Servers <span data-kid=\"2-1-1-1-1\" data-name=\"current page crumb segment\">/ Residential ISP VPS</span></div>\n<h1 data-kid=\"2-1-1-2\" data-name=\"page main headline\">Residential ISP VPS</h1>\n<p data-kid=\"2-1-1-3\" data-name=\"page description text\">Static AT&amp;T, Comcast and Verizon residential IPs on KVM. Provisioned in under 90 seconds.</p>\n</div>\n<div class=\"band-right\" data-kid=\"2-1-2\" data-name=\"title band actions group\">\n<a class=\"wa\" data-kid=\"2-1-2-1\" data-name=\"WhatsApp contact button\"><i class=\"icon-message-circle\" data-kid=\"2-1-2-1-1\" data-name=\"WhatsApp message icon\"></i> WhatsApp</a>\n<a class=\"lc\" data-kid=\"2-1-2-2\" data-name=\"talk to engineer button\"><i class=\"icon-life-buoy\" data-kid=\"2-1-2-2-1\" data-name=\"life buoy support icon\"></i> Talk to an engineer</a>\n</div>\n</div>\n</div>\n<div class=\"body\" data-kid=\"3\" data-name=\"page body container\">\n<div class=\"wrap layout\" data-kid=\"3-1\" data-name=\"two-column layout wrapper\">\n<div data-kid=\"3-1-1\" data-name=\"left content column\">\n<div class=\"cfg\" data-kid=\"3-1-1-1\" data-name=\"configuration controls strip\">\n<div data-kid=\"3-1-1-1-1\" data-name=\"billing period selector group\" style=\"display:flex;align-items:center\">\n<span class=\"cfg-lab\" data-kid=\"3-1-1-1-1-1\" data-name=\"billing period label\">Billing</span>\n<div class=\"seg\" data-kid=\"3-1-1-1-1-2\" data-name=\"billing segmented control\">\n<button class=\"on\" data-kid=\"3-1-1-1-1-2-1\" data-name=\"1 month billing option\">1 month</button>\n<button data-kid=\"3-1-1-1-1-2-2\" data-name=\"3 months billing option\">3 months<em data-kid=\"3-1-1-1-1-2-2-1\" data-name=\"5 percent discount tag\">−5%</em></button>\n<button data-kid=\"3-1-1-1-1-2-3\" data-name=\"12 months billing option\">12 months<em data-kid=\"3-1-1-1-1-2-3-1\" data-name=\"15 percent discount tag\">−15%</em></button>\n</div>\n</div>\n<div data-kid=\"3-1-1-1-2\" data-name=\"carrier selector group\" style=\"display:flex;align-items:center\">\n<span class=\"cfg-lab\" data-kid=\"3-1-1-1-2-1\" data-name=\"carrier label\">Carrier</span>\n<div class=\"chips\" data-kid=\"3-1-1-1-2-2\" data-name=\"carrier chip selector\">\n<button class=\"chip on\" data-kid=\"3-1-1-1-2-2-1\" data-name=\"AT&amp;T carrier chip\">AT&amp;T</button>\n<button class=\"chip\" data-kid=\"3-1-1-1-2-2-2\" data-name=\"Comcast carrier chip\">Comcast</button>\n<button class=\"chip\" data-kid=\"3-1-1-1-2-2-3\" data-name=\"Verizon carrier chip\">Verizon</button>\n<button class=\"chip\" data-kid=\"3-1-1-1-2-2-4\" data-name=\"Spectrum carrier chip\">Spectrum</button>\n</div>\n</div>\n</div>\n<div class=\"defs\" data-kid=\"3-1-1-2\" data-name=\"IP type definitions section\">\n<div data-kid=\"3-1-1-2-1\" data-name=\"clean screened IP definition card\">\n<h3 data-kid=\"3-1-1-2-1-1\" data-name=\"definition card title\"><i class=\"icon-shield-check\" data-kid=\"3-1-1-2-1-1-1\" data-name=\"shield check icon\"></i> Clean screened IP</h3>\n<p data-kid=\"3-1-1-2-1-2\" data-name=\"definition description text\">IPQS score at or below 15 when the server is handed over. One free swap within 168 hours if the score rises.</p>\n<div class=\"pr mono\" data-kid=\"3-1-1-2-1-3\" data-name=\"price range line\">৳2,999 – ৳4,999 per month</div>\n</div>\n<div data-kid=\"3-1-1-2-2\" data-name=\"virgin fresh IP definition card\">\n<h3 data-kid=\"3-1-1-2-2-1\" data-name=\"definition card title\"><i class=\"icon-refresh-cw\" data-kid=\"3-1-1-2-2-1-1\" data-name=\"refresh icon\"></i> Virgin fresh IP</h3>\n<p data-kid=\"3-1-1-2-2-2\" data-name=\"definition description text\">Newly allocated and never used on a survey panel. Adds ৳500 per month on Starter and Pro; included on VIP.</p>\n<div class=\"pr mono\" data-kid=\"3-1-1-2-2-3\" data-name=\"price range line\">৳3,499 – ৳4,999 per month</div>\n</div>\n</div>\n<div class=\"mx-wrap\" data-kid=\"3-1-1-3\" data-name=\"plan comparison table wrapper\">\n<table class=\"mx\" data-kid=\"3-1-1-3-1\" data-name=\"plan comparison table\">\n<colgroup data-kid=\"3-1-1-3-1-1\" data-name=\"table column definitions\">\n<col class=\"lab\" data-kid=\"3-1-1-3-1-1-1\" data-name=\"feature label column\"/>\n<col data-kid=\"3-1-1-3-1-1-2\" data-name=\"starter plan column\"/>\n<col class=\"hl\" data-kid=\"3-1-1-3-1-1-3\" data-name=\"highlighted pro plan column\"/>\n<col data-kid=\"3-1-1-3-1-1-4\" data-name=\"VIP plan column\"/>\n</colgroup>\n<thead data-kid=\"3-1-1-3-1-2\" data-name=\"plan header row\">\n<tr data-kid=\"3-1-1-3-1-2-1\" data-name=\"header row false\">\n<th data-kid=\"3-1-1-3-1-2-1-1\" data-name=\"compare column header label\" style=\"font-size:11.5px;font-weight:600;color:#94a3b8;letter-spacing:.03em;text-transform:uppercase;padding-top:22px\">Compare</th>\n<th data-kid=\"3-1-1-3-1-2-1-2\" data-name=\"starter plan header cell\">\n<div class=\"ph-top\" data-kid=\"3-1-1-3-1-2-1-2-1\" data-name=\"starter selection row\"><span class=\"radio\" data-kid=\"3-1-1-3-1-2-1-2-1-1\" data-name=\"starter radio selector\"></span><span class=\"stock mono\" data-kid=\"3-1-1-3-1-2-1-2-1-2\" data-name=\"starter stock availability label\"><span class=\"dot\" data-kid=\"3-1-1-3-1-2-1-2-1-2-1\" data-name=\"availability status dot\" style=\"background:#10b981\"></span><b data-kid=\"3-1-1-3-1-2-1-2-1-2-2\" data-name=\"available units count\">8</b> available</span></div>\n<div class=\"pname\" data-kid=\"3-1-1-3-1-2-1-2-2\" data-name=\"starter plan name\">Starter Survey VPS</div>\n<div class=\"ptag\" data-kid=\"3-1-1-3-1-2-1-2-3\" data-name=\"starter plan tagline\">One or two accounts</div>\n</th>\n<th class=\"on\" data-kid=\"3-1-1-3-1-2-1-3\" data-name=\"pro plan header cell\">\n<div class=\"ph-top\" data-kid=\"3-1-1-3-1-2-1-3-1\" data-name=\"pro selection row\"><span class=\"radio on\" data-kid=\"3-1-1-3-1-2-1-3-1-1\" data-name=\"pro radio selector (selected)\"></span><span class=\"stock mono\" data-kid=\"3-1-1-3-1-2-1-3-1-2\" data-name=\"pro stock availability label\"><span class=\"dot\" data-kid=\"3-1-1-3-1-2-1-3-1-2-1\" data-name=\"availability status dot\" style=\"background:#10b981\"></span><b data-kid=\"3-1-1-3-1-2-1-3-1-2-2\" data-name=\"available units count\">5</b> available</span></div>\n<div class=\"pname\" data-kid=\"3-1-1-3-1-2-1-3-2\" data-name=\"pro plan name\">Pro Survey VPS</div>\n<div class=\"ptag\" data-kid=\"3-1-1-3-1-2-1-3-3\" data-name=\"pro plan tagline\">Several accounts at once</div>\n</th>\n<th data-kid=\"3-1-1-3-1-2-1-4\" data-name=\"VIP plan header cell\">\n<div class=\"ph-top\" data-kid=\"3-1-1-3-1-2-1-4-1\" data-name=\"VIP selection row\"><span class=\"radio\" data-kid=\"3-1-1-3-1-2-1-4-1-1\" data-name=\"VIP radio selector\"></span><span class=\"stock mono\" data-kid=\"3-1-1-3-1-2-1-4-1-2\" data-name=\"VIP stock availability label\"><span class=\"dot\" data-kid=\"3-1-1-3-1-2-1-4-1-2-1\" data-name=\"availability status dot\" style=\"background:#10b981\"></span><b data-kid=\"3-1-1-3-1-2-1-4-1-2-2\" data-name=\"available units count\">3</b> available</span></div>\n<div class=\"pname\" data-kid=\"3-1-1-3-1-2-1-4-2\" data-name=\"VIP plan name\">VIP Fresh ISP VPS</div>\n<div class=\"ptag\" data-kid=\"3-1-1-3-1-2-1-4-3\" data-name=\"VIP plan tagline\">Never-used IPs, 8 GB memory</div>\n</th>\n</tr>\n</thead>\n<tbody data-kid=\"3-1-1-3-1-3\" data-name=\"comparison rows body\">\n<tr data-kid=\"3-1-1-3-1-3-1\" data-name=\"monthly price row (clean IP)\">\n<td class=\"rowlab\" data-kid=\"3-1-1-3-1-3-1-1\" data-name=\"feature label with sublabel\"><span class=\"rlab-main\" data-kid=\"3-1-1-3-1-3-1-1-1\" data-name=\"main label text\">Monthly price</span><span class=\"rlab-sub\" data-kid=\"3-1-1-3-1-3-1-1-2\" data-name=\"sublabel text\">clean IP</span></td>\n<td data-kid=\"3-1-1-3-1-3-1-2\" data-name=\"starter cell\"><span class=\"money\" data-kid=\"3-1-1-3-1-3-1-2-1\" data-name=\"money amount display\">৳2,999<small data-kid=\"3-1-1-3-1-3-1-2-1-1\" data-name=\"per-month unit suffix\">/mo</small></span></td>\n<td data-kid=\"3-1-1-3-1-3-1-3\" data-name=\"pro cell\"><span class=\"money\" data-kid=\"3-1-1-3-1-3-1-3-1\" data-name=\"money amount display\">৳3,799<small data-kid=\"3-1-1-3-1-3-1-3-1-1\" data-name=\"per-month unit suffix\">/mo</small></span></td>\n<td data-kid=\"3-1-1-3-1-3-1-4\" data-name=\"VIP cell\"><span class=\"money\" data-kid=\"3-1-1-3-1-3-1-4-1\" data-name=\"money amount display\">৳4,999<small data-kid=\"3-1-1-3-1-3-1-4-1-1\" data-name=\"per-month unit suffix\">/mo</small></span></td>\n</tr>\n<tr data-kid=\"3-1-1-3-1-3-2\" data-name=\"monthly price row (virgin)\">\n<td class=\"rowlab\" data-kid=\"3-1-1-3-1-3-2-1\" data-name=\"feature label with sublabel\"><span class=\"rlab-main\" data-kid=\"3-1-1-3-1-3-2-1-1\" data-name=\"main label text\">Monthly price</span><span class=\"rlab-sub\" data-kid=\"3-1-1-3-1-3-2-1-2\" data-name=\"sublabel text\">virgin fresh IP</span></td>\n<td data-kid=\"3-1-1-3-1-3-2-2\" data-name=\"starter cell\"><span class=\"money\" data-kid=\"3-1-1-3-1-3-2-2-1\" data-name=\"money amount display\">৳3,499<small data-kid=\"3-1-1-3-1-3-2-2-1-1\" data-name=\"per-month unit suffix\">/mo</small></span></td>\n<td data-kid=\"3-1-1-3-1-3-2-3\" data-name=\"pro cell\"><span class=\"money\" data-kid=\"3-1-1-3-1-3-2-3-1\" data-name=\"money amount display\">৳4,299<small data-kid=\"3-1-1-3-1-3-2-3-1-1\" data-name=\"per-month unit suffix\">/mo</small></span></td>\n<td data-kid=\"3-1-1-3-1-3-2-4\" data-name=\"VIP cell\"><span class=\"money\" data-kid=\"3-1-1-3-1-3-2-4-1\" data-name=\"money amount display\">৳4,999<small data-kid=\"3-1-1-3-1-3-2-4-1-1\" data-name=\"per-month unit suffix\">/mo</small></span></td>\n</tr>\n<tr data-kid=\"3-1-1-3-1-3-3\" data-name=\"vCPU feature row\">\n<td class=\"rowlab\" data-kid=\"3-1-1-3-1-3-3-1\" data-name=\"feature label text\">Dedicated vCPU</td>\n<td data-kid=\"3-1-1-3-1-3-3-2\" data-name=\"starter value cell\">2 cores</td>\n<td data-kid=\"3-1-1-3-1-3-3-3\" data-name=\"pro value cell\">4 cores</td>\n<td data-kid=\"3-1-1-3-1-3-3-4\" data-name=\"VIP value cell\">4 cores</td>\n</tr>\n<tr data-kid=\"3-1-1-3-1-3-4\" data-name=\"memory feature row\">\n<td class=\"rowlab\" data-kid=\"3-1-1-3-1-3-4-1\" data-name=\"feature label text\">ECC memory</td>\n<td data-kid=\"3-1-1-3-1-3-4-2\" data-name=\"starter value cell\">4 GB DDR4</td>\n<td data-kid=\"3-1-1-3-1-3-4-3\" data-name=\"pro value cell\">6 GB DDR4</td>\n<td data-kid=\"3-1-1-3-1-3-4-4\" data-name=\"VIP value cell\">8 GB DDR4</td>\n</tr>\n<tr data-kid=\"3-1-1-3-1-3-5\" data-name=\"storage feature row\">\n<td class=\"rowlab\" data-kid=\"3-1-1-3-1-3-5-1\" data-name=\"feature label text\">NVMe RAID-1</td>\n<td data-kid=\"3-1-1-3-1-3-5-2\" data-name=\"starter value cell\">45 GB</td>\n<td data-kid=\"3-1-1-3-1-3-5-3\" data-name=\"pro value cell\">60 GB</td>\n<td data-kid=\"3-1-1-3-1-3-5-4\" data-name=\"VIP value cell\">80 GB</td>\n</tr>\n<tr data-kid=\"3-1-1-3-1-3-6\" data-name=\"Windows image feature row\">\n<td class=\"rowlab\" data-kid=\"3-1-1-3-1-3-6-1\" data-name=\"feature label text\">Windows image</td>\n<td data-kid=\"3-1-1-3-1-3-6-2\" data-name=\"starter value cell\">10 Pro, hardened</td>\n<td data-kid=\"3-1-1-3-1-3-6-3\" data-name=\"pro value cell\">10 Pro, hardened</td>\n<td data-kid=\"3-1-1-3-1-3-6-4\" data-name=\"VIP value cell\">10 or 11 Pro</td>\n</tr>\n<tr data-kid=\"3-1-1-3-1-3-7\" data-name=\"carriers feature row\">\n<td class=\"rowlab\" data-kid=\"3-1-1-3-1-3-7-1\" data-name=\"feature label text\">Carriers</td>\n<td data-kid=\"3-1-1-3-1-3-7-2\" data-name=\"starter value cell\">AT&amp;T, Comcast, Verizon, Spectrum</td>\n<td data-kid=\"3-1-1-3-1-3-7-3\" data-name=\"pro value cell\">AT&amp;T, Comcast</td>\n<td data-kid=\"3-1-1-3-1-3-7-4\" data-name=\"VIP value cell\">AT&amp;T, Comcast, Verizon</td>\n</tr>\n</tbody>\n<tfoot data-kid=\"3-1-1-3-1-4\" data-name=\"table footer row\">\n<tr data-kid=\"3-1-1-3-1-4-1\" data-name=\"footer row\">\n<td data-kid=\"3-1-1-3-1-4-1-1\" data-name=\"empty footer cell\"></td>\n<td data-kid=\"3-1-1-3-1-4-1-2\" data-name=\"starter select cell\"><a class=\"pick\" data-kid=\"3-1-1-3-1-4-1-2-1\" data-name=\"select plan link\">Select plan <i class=\"icon-arrow-right\" data-kid=\"3-1-1-3-1-4-1-2-1-1\" data-name=\"right arrow icon\"></i></a></td>\n<td data-kid=\"3-1-1-3-1-4-1-3\" data-name=\"pro selected cell\"><span class=\"pick sel\" data-kid=\"3-1-1-3-1-4-1-3-1\" data-name=\"selected indicator\"><i class=\"icon-check\" data-kid=\"3-1-1-3-1-4-1-3-1-1\" data-name=\"checkmark icon\"></i> Selected</span></td>\n<td data-kid=\"3-1-1-3-1-4-1-4\" data-name=\"VIP select cell\"><a class=\"pick\" data-kid=\"3-1-1-3-1-4-1-4-1\" data-name=\"select plan link\">Select plan <i class=\"icon-arrow-right\" data-kid=\"3-1-1-3-1-4-1-4-1-1\" data-name=\"right arrow icon\"></i></a></td>\n</tr>\n</tfoot>\n</table>\n</div>\n<div class=\"matrix-note\" data-kid=\"3-1-1-4\" data-name=\"plan features note\"><i class=\"icon-circle-check\" data-kid=\"3-1-1-4-1\" data-name=\"check circle icon\"></i> Every plan is KVM with full administrator access. No control-panel licence is added.</div>\n<div class=\"facts\" data-kid=\"3-1-1-5\" data-name=\"shared plan facts section\">\n<div class=\"fr\" data-kid=\"3-1-1-5-1\" data-name=\"first fact row\"><div class=\"fk\" data-kid=\"3-1-1-5-1-1\" data-name=\"fact label\">Included on every plan</div><div class=\"fv\" data-kid=\"3-1-1-5-1-2\" data-name=\"fact value text\">KVM virtualization, full administrator access, 1 Gbps unmetered, 1 dedicated IPv4 with rDNS, /64 IPv6 subnet, reboot API</div></div>\n<div class=\"fr\" data-kid=\"3-1-1-5-2\" data-name=\"second fact row\"><div class=\"fk\" data-kid=\"3-1-1-5-2-1\" data-name=\"fact label\">Screening at handover</div><div class=\"fv\" data-kid=\"3-1-1-5-2-2\" data-name=\"fact value text\">IPQS score recorded in the client area before delivery; a score above 15 qualifies for replacement</div></div>\n<div class=\"fr\" data-kid=\"3-1-1-5-3\" data-name=\"third fact row\"><div class=\"fk\" data-kid=\"3-1-1-5-3-1\" data-name=\"fact label\">Replacement policy</div><div class=\"fv\" data-kid=\"3-1-1-5-3-2\" data-name=\"fact value text\">One free IP swap within 168 hours of delivery, requested from the server page</div></div>\n<div class=\"fr\" data-kid=\"3-1-1-5-4\" data-name=\"fourth fact row\"><div class=\"fk\" data-kid=\"3-1-1-5-4-1\" data-name=\"fact label\">Term and renewal</div><div class=\"fv\" data-kid=\"3-1-1-5-4-2\" data-name=\"fact value text\">Billed for the term you choose; the renewal amount is shown before payment and again on the invoice</div></div>\n</div>\n<div class=\"faq\" data-kid=\"3-1-1-6\" data-name=\"FAQ section\">\n<h2 data-kid=\"3-1-1-6-1\" data-name=\"FAQ heading\">Before you order</h2>\n<div class=\"qa\" data-kid=\"3-1-1-6-2\" data-name=\"first FAQ item\">\n<h4 data-kid=\"3-1-1-6-2-1\" data-name=\"FAQ question text\">Can I pay monthly with bKash or Nagad? <i class=\"icon-plus\" data-kid=\"3-1-1-6-2-1-1\" data-name=\"expand plus icon\"></i></h4>\n<p data-kid=\"3-1-1-6-2-2\" data-name=\"FAQ answer text\">Yes. bKash, Nagad, Rocket and cards are billed for the term you pick. bKash and Nagad are approved inside their apps, and the server is provisioned once the gateway confirms.</p>\n</div>\n<div class=\"qa\" data-kid=\"3-1-1-6-3\" data-name=\"second FAQ item\">\n<h4 data-kid=\"3-1-1-6-3-1\" data-name=\"FAQ question text\">What if the IP is flagged after delivery? <i class=\"icon-plus\" data-kid=\"3-1-1-6-3-1-1\" data-name=\"expand plus icon\"></i></h4>\n<p data-kid=\"3-1-1-6-3-2\" data-name=\"FAQ answer text\">Open the server page and request the free swap within 168 hours of delivery. A new residential IP is bound to the same KVM slice.</p>\n</div>\n<div class=\"qa\" data-kid=\"3-1-1-6-4\" data-name=\"third FAQ item\">\n<h4 data-kid=\"3-1-1-6-4-1\" data-name=\"FAQ question text\">Is the server shared with other customers? <i class=\"icon-plus\" data-kid=\"3-1-1-6-4-1-1\" data-name=\"expand plus icon\"></i></h4>\n<p data-kid=\"3-1-1-6-4-2\" data-name=\"FAQ answer text\">Each plan is a dedicated KVM slice with its own IPv4 address, rDNS and administrator password. No proxy pool, no shared session.</p>\n</div>\n</div>\n</div>\n<aside class=\"rail\" data-kid=\"3-1-2\" data-name=\"right order rail\">\n<div class=\"order\" data-kid=\"3-1-2-1\" data-name=\"order summary card\">\n<div class=\"order-hd\" data-kid=\"3-1-2-1-1\" data-name=\"order card header\">\n<div class=\"oh-top\" data-kid=\"3-1-2-1-1-1\" data-name=\"order meta row\">\n<span class=\"oh-lab mono\" data-kid=\"3-1-2-1-1-1-1\" data-name=\"order type label\">Order</span>\n<span class=\"oh-term\" data-kid=\"3-1-2-1-1-1-2\" data-name=\"term badge\">1 month</span>\n</div>\n<div class=\"oh-name\" data-kid=\"3-1-2-1-1-2\" data-name=\"order plan name\">Pro Survey VPS</div>\n<div class=\"oh-spec\" data-kid=\"3-1-2-1-1-3\" data-name=\"order spec line\">4 vCPU · 6 GB ECC · 60 GB NVMe</div>\n<div class=\"oh-total\" data-kid=\"3-1-2-1-1-4\" data-name=\"order total row\"><strong data-kid=\"3-1-2-1-1-4-1\" data-name=\"total amount display\">৳3,419</strong><span data-kid=\"3-1-2-1-1-4-2\" data-name=\"due today caption\">due today</span></div>\n</div>\n<div class=\"order-bd\" data-kid=\"3-1-2-1-2\" data-name=\"order form body\">\n<div class=\"orow\" data-kid=\"3-1-2-1-2-1\" data-name=\"term selection row\">\n<span class=\"olab\" data-kid=\"3-1-2-1-2-1-1\" data-name=\"form field label\">Term</span>\n<div class=\"seg2 three\" data-kid=\"3-1-2-1-2-1-2\" data-name=\"term option grid\">\n<button class=\"opt on\" data-kid=\"3-1-2-1-2-1-2-1\" data-name=\"1 month option button\">1 mo</button>\n<button class=\"opt\" data-kid=\"3-1-2-1-2-1-2-2\" data-name=\"3 months option button\">3 mo<small data-kid=\"3-1-2-1-2-1-2-2-1\" data-name=\"discount note\">−5%</small></button>\n<button class=\"opt\" data-kid=\"3-1-2-1-2-1-2-3\" data-name=\"12 months option button\">12 mo<small data-kid=\"3-1-2-1-2-1-2-3-1\" data-name=\"discount note\">−15%</small></button>\n</div>\n</div>\n<div class=\"orow\" data-kid=\"3-1-2-1-2-2\" data-name=\"IP type selection row\">\n<span class=\"olab\" data-kid=\"3-1-2-1-2-2-1\" data-name=\"form field label\">IP type</span>\n<div class=\"seg2\" data-kid=\"3-1-2-1-2-2-2\" data-name=\"IP type option grid\">\n<button class=\"opt on\" data-kid=\"3-1-2-1-2-2-2-1\" data-name=\"clean screened IP option\">Clean screened<small data-kid=\"3-1-2-1-2-2-2-1-1\" data-name=\"price per month note\">৳3,799 / mo</small></button>\n<button class=\"opt\" data-kid=\"3-1-2-1-2-2-2-2\" data-name=\"virgin fresh IP option\">Virgin fresh<small data-kid=\"3-1-2-1-2-2-2-2-1\" data-name=\"price per month note\">৳4,299 / mo</small></button>\n</div>\n</div>\n<div class=\"orow\" data-kid=\"3-1-2-1-2-3\" data-name=\"carrier selection row\">\n<span class=\"olab\" data-kid=\"3-1-2-1-2-3-1\" data-name=\"form field label\">Carrier</span>\n<div class=\"seg2\" data-kid=\"3-1-2-1-2-3-2\" data-name=\"first carrier grid\" style=\"grid-template-columns:1fr 1fr\">\n<button class=\"opt on\" data-kid=\"3-1-2-1-2-3-2-1\" data-name=\"AT&amp;T option button\">AT&amp;T</button>\n<button class=\"opt\" data-kid=\"3-1-2-1-2-3-2-2\" data-name=\"Comcast option button\">Comcast</button>\n</div>\n<div class=\"seg2\" data-kid=\"3-1-2-1-2-3-3\" data-name=\"second carrier grid\" style=\"grid-template-columns:1fr 1fr;margin-top:6px\">\n<button class=\"opt\" data-kid=\"3-1-2-1-2-3-3-1\" data-name=\"Verizon option button (disabled)\" disabled=\"\">Verizon</button>\n<button class=\"opt\" data-kid=\"3-1-2-1-2-3-3-2\" data-name=\"Spectrum option button (disabled)\" disabled=\"\">Spectrum</button>\n</div>\n<p class=\"hint\" data-kid=\"3-1-2-1-2-3-4\" data-name=\"hint explanation text\">Verizon and Spectrum ship on Starter and VIP.</p>\n</div>\n<div class=\"orow\" data-kid=\"3-1-2-1-2-4\" data-name=\"location selection row\" style=\"margin-bottom:0\">\n<span class=\"olab\" data-kid=\"3-1-2-1-2-4-1\" data-name=\"form field label\">Location</span>\n<div class=\"seg2\" data-kid=\"3-1-2-1-2-4-2\" data-name=\"location option grid\">\n<button class=\"opt on\" data-kid=\"3-1-2-1-2-4-2-1\" data-name=\"Dallas location option\">Dallas, TX<small data-kid=\"3-1-2-1-2-4-2-1-1\" data-name=\"datacenter location note\">Infomart</small></button>\n<button class=\"opt\" data-kid=\"3-1-2-1-2-4-2-2\" data-name=\"Ashburn location option\">Ashburn, VA<small data-kid=\"3-1-2-1-2-4-2-2-1\" data-name=\"datacenter location note\">Equinix DC</small></button>\n</div>\n</div>\n<div class=\"hr\" data-dynamic=\"true\" data-kid=\"3-1-2-1-2-5\" data-name=\"hr divider\" data-reason=\"text replaced every second by countdown script\"></div>\n<div class=\"sum\" data-kid=\"3-1-2-1-2-6\" data-name=\"price summary line\"><span data-kid=\"3-1-2-1-2-6-1\" data-name=\"line item label\">Pro Survey VPS · clean IP</span><span class=\"v\" data-kid=\"3-1-2-1-2-6-2\" data-name=\"line item value\">৳3,799</span></div>\n<div class=\"sum\" data-kid=\"3-1-2-1-2-7\" data-name=\"term summary line\"><span data-kid=\"3-1-2-1-2-7-1\" data-name=\"line item label\">Term</span><span class=\"v\" data-kid=\"3-1-2-1-2-7-2\" data-name=\"line item value\">1 month</span></div>\n<div class=\"sum disc\" data-kid=\"3-1-2-1-2-8\" data-name=\"coupon discount line\"><span data-kid=\"3-1-2-1-2-8-1\" data-name=\"line item label\">Coupon LAUNCH10</span><span class=\"v\" data-kid=\"3-1-2-1-2-8-2\" data-name=\"discount value\">−৳380</span></div>\n<div class=\"sum tot\" data-kid=\"3-1-2-1-2-9\" data-name=\"total due line\"><span data-kid=\"3-1-2-1-2-9-1\" data-name=\"line item label\">Due today</span><span class=\"v\" data-kid=\"3-1-2-1-2-9-2\" data-name=\"total value\">৳3,419</span></div>\n<p class=\"hint\" data-kid=\"3-1-2-1-2-10\" data-name=\"renewal hint text\">Renews 17 Dec 2026 at ৳3,799.</p>\n<div class=\"hr\" data-kid=\"3-1-2-1-2-11\" data-name=\"hr divider\"></div>\n<div class=\"field\" data-kid=\"3-1-2-1-2-12\" data-name=\"email input field\">\n<span class=\"olab\" data-kid=\"3-1-2-1-2-12-1\" data-name=\"field label\">Receipt email</span>\n<input data-kid=\"3-1-2-1-2-12-2\" data-name=\"email input\" value=\"asif@rongdhonu.bd\"/>\n</div>\n<div class=\"orow\" data-kid=\"3-1-2-1-2-13\" data-name=\"payment method selector\" style=\"margin-top:12px;margin-bottom:8px\">\n<span class=\"olab\" data-kid=\"3-1-2-1-2-13-1\" data-name=\"field label\">Pay with</span>\n<div class=\"pay\" data-kid=\"3-1-2-1-2-13-2\" data-name=\"payment buttons grid\">\n<button class=\"paybtn on\" data-kid=\"3-1-2-1-2-13-2-1\" data-name=\"bKash pay button\"><span class=\"mk\" data-kid=\"3-1-2-1-2-13-2-1-1\" data-name=\"bKash logo text\" style=\"color:#e2136e\">bKash</span></button>\n<button class=\"paybtn\" data-kid=\"3-1-2-1-2-13-2-2\" data-name=\"Nagad pay button\"><span class=\"mk\" data-kid=\"3-1-2-1-2-13-2-2-1\" data-name=\"Nagad logo text\" style=\"color:#f6921e\">Nagad</span></button>\n<button class=\"paybtn\" data-kid=\"3-1-2-1-2-13-2-3\" data-name=\"Rocket pay button\"><span class=\"mk\" data-kid=\"3-1-2-1-2-13-2-3-1\" data-name=\"Rocket logo text\" style=\"color:#8e2a8e\">Rocket</span></button>\n<button class=\"paybtn\" data-kid=\"3-1-2-1-2-13-2-4\" data-name=\"credit card pay button\"><i class=\"icon-credit-card\" data-kid=\"3-1-2-1-2-13-2-4-1\" data-name=\"credit card icon\"></i> Card</button>\n</div>\n</div>\n<div class=\"field\" data-kid=\"3-1-2-1-2-14\" data-name=\"bKash mobile account field\">\n<span class=\"olab\" data-kid=\"3-1-2-1-2-14-1\" data-name=\"field label\">bKash mobile account</span>\n<input data-kid=\"3-1-2-1-2-14-2\" data-name=\"mobile number input\" value=\"017 1234 5678\"/>\n<p class=\"hint\" data-kid=\"3-1-2-1-2-14-3\" data-name=\"instruction hint text\">You approve the ৳3,419 request in the bKash app. Server credentials are emailed once the gateway confirms.</p>\n</div>\n<button class=\"cta\" data-kid=\"3-1-2-1-2-15\" data-name=\"primary pay CTA button\">Pay ৳3,419 with bKash <i class=\"icon-arrow-right\" data-kid=\"3-1-2-1-2-15-1\" data-name=\"right arrow icon\"></i></button>\n<div class=\"cta-note\" data-kid=\"3-1-2-1-2-16\" data-name=\"provisioning status note\"><i class=\"icon-circle-check\" data-kid=\"3-1-2-1-2-16-1\" data-name=\"check circle icon\"></i> Provisioning starts when bKash confirms</div>\n<div class=\"secure\" data-kid=\"3-1-2-1-2-17\" data-name=\"security reassurance line\"><i class=\"icon-shield-check\" data-kid=\"3-1-2-1-2-17-1\" data-name=\"shield check icon\"></i> 256-bit TLS · no card data stored</div>\n</div>\n<div class=\"order-ft\" data-kid=\"3-1-2-1-3\" data-name=\"order card footer\">\n<a data-kid=\"3-1-2-1-3-1\" data-name=\"WhatsApp support link\"><i class=\"icon-message-circle\" data-kid=\"3-1-2-1-3-1-1\" data-name=\"WhatsApp message icon\"></i> WhatsApp support</a>\n<a data-kid=\"3-1-2-1-3-2\" data-name=\"live chat link\"><i class=\"icon-life-buoy\" data-kid=\"3-1-2-1-3-2-1\" data-name=\"life buoy icon\"></i> Live chat</a>\n</div>\n</div>\n</aside>\n</div>\n</div>\n<footer class=\"ftr\" data-kid=\"4\" data-name=\"site footer\">\n<div class=\"ftr-in wrap\" data-kid=\"4-1\" data-name=\"footer inner container\">\n<div class=\"ftr-l\" data-kid=\"4-1-1\" data-name=\"footer left group\">\n<span class=\"brand\" data-kid=\"4-1-1-1\" data-name=\"footer brand text\">primevpsbd</span>\n<span class=\"ftr-meta mono\" data-kid=\"4-1-1-2\" data-name=\"company address line\">Banani, Dhaka 1213 · Dallas, TX</span>\n</div>\n<div class=\"ftr-r\" data-kid=\"4-1-2\" data-name=\"footer links group\">\n<span data-kid=\"4-1-2-1\" data-name=\"APNIC member note\">APNIC NIR member</span>\n<span class=\"sep\" data-kid=\"4-1-2-2\" data-name=\"separator bar\"></span>\n<a data-kid=\"4-1-2-3\" data-name=\"terms link\">Terms</a>\n<a data-kid=\"4-1-2-4\" data-name=\"privacy link\">Privacy</a>\n<a data-kid=\"4-1-2-5\" data-name=\"status link\">Status</a>\n<a data-kid=\"4-1-2-6\" data-name=\"reseller pricing link\">Reseller pricing</a>\n</div>\n</div>\n</footer>\n",
      "comments": [],
      "created": "2026-11-17T19:07:21.884743+00:00",
      "modified": "2026-11-17T19:13:50.195179+00:00",
      "id": "var_0183e1cca709",
      "contentHeight": 1602
    },
    "var_a25665870e19": {
      "type": "variant",
      "label": "Client area — service console, IP health, billing",
      "parentId": "var_0183e1cca709",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n:root{\n  --page:#ffffff; --surface:#f8fafc; --surface-2:#f1f5f9;\n  --ink:#0b1220; --ink-2:#151d30;\n  --border:#e2e8f0; --border-soft:#eef2f7; --border-strong:#cbd5e1;\n  --text:#0f172a; --muted:#64748b; --muted-2:#94a3b8;\n  --accent:#2563eb; --accent-hover:#1d4ed8; --accent-subtle:#eff6ff; --accent-line:#c7d9fd; --accent-wash:#f6f9ff;\n  --success:#047857; --success-bg:#ecfdf5; --warning:#b45309; --warning-bg:#fffbeb; --danger:#b91c1c; --danger-bg:#fef2f2;\n  --r-card:14px;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:var(--surface);color:var(--text);font-family:'Inter',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}\na{color:inherit;text-decoration:none}\nbutton{font:inherit;color:inherit;background:none;border:0;cursor:pointer}\ni[class^=\"icon-\"]{font-size:15px;line-height:1;display:inline-block;vertical-align:-2px}\n.display{font-family:'Plus Jakarta Sans','Inter',sans-serif;letter-spacing:-.025em}\n.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;letter-spacing:-.01em}\n\n/* topbar */\n.topbar{height:60px;background:#fff;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;gap:24px}\n.tb-left{display:flex;align-items:center;gap:16px}\n.brand{font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;font-weight:800;letter-spacing:-.035em}\n.tb-sep{width:1px;height:18px;background:var(--border)}\n.tb-ws{font-size:13px;font-weight:500;color:#334155}\n.tb-right{display:flex;align-items:center;gap:14px}\n.iconbtn{width:32px;height:32px;border:1px solid var(--border);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;color:#475569;background:#fff}\n.lang{border:1px solid var(--border);border-radius:8px;padding:4px 8px;font-size:11.5px;color:#334155;background:#fff}\n.cur{display:inline-flex;border:1px solid var(--border);border-radius:8px;overflow:hidden;font-size:11.5px}\n.cur b{background:var(--accent);color:#fff;padding:4px 7px;font-weight:500}\n.cur span{padding:4px 7px;color:var(--muted)}\n.who{display:flex;align-items:center;gap:8px;padding-left:4px}\n.av{width:28px;height:28px;border-radius:50%;background:#0b1220;color:#fff;font-size:11px;font-weight:600;display:flex;align-items:center;justify-content:center;letter-spacing:.02em}\n.who-name{font-size:12.5px;font-weight:500;color:#334155}\n\n/* shell */\n.shell{display:grid;grid-template-columns:208px minmax(0,1fr);min-height:calc(100vh - 60px)}\n.side{background:#fff;border-right:1px solid var(--border);padding:16px 12px;display:flex;flex-direction:column;justify-content:space-between}\n.snav{display:flex;flex-direction:column;gap:2px}\n.snav a{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:8px;font-size:13px;font-weight:500;color:#475569}\n.snav a i{font-size:15px;color:#94a3b8}\n.snav a.on{background:var(--accent-subtle);color:var(--accent-hover);font-weight:600}\n.snav a.on i{color:var(--accent)}\n.snav .count{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:11px;color:#94a3b8}\n.sgroup{font-size:10.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#94a3b8;padding:0 10px;margin:16px 0 6px}\n.side-ft{border-top:1px solid var(--border-soft);padding-top:12px}\n.side-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px}\n.side-card h4{font-size:11.5px;font-weight:600;display:flex;align-items:center;gap:6px}\n.side-card h4 i{color:var(--success);font-size:13px}\n.side-card p{font-size:11px;color:var(--muted);margin-top:3px;line-height:1.4}\n.side-card a{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:var(--accent);margin-top:7px}\n\n.main{padding:22px 28px 40px;min-width:0}\n.phead{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:18px}\n.phead h1{font-family:'Plus Jakarta Sans',sans-serif;font-size:24px;font-weight:800;letter-spacing:-.03em}\n.phead .sub{display:flex;align-items:center;gap:8px;margin-top:5px;font-size:12.5px;color:var(--muted)}\n.phead .sub .mono{color:#475569}\n.phead-actions{display:flex;align-items:center;gap:8px}\n.btn{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 12px;border-radius:9px;font-size:12.5px;font-weight:600}\n.btn-p{background:var(--accent);color:#fff;box-shadow:0 8px 16px -12px rgba(37,99,235,.9)}\n.btn-g{background:#fff;border:1px solid var(--border);color:#334155}\n\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 356px;gap:20px;align-items:start}\n\n/* console */\n.console{background:var(--ink);border-radius:var(--r-card);padding:18px 20px 16px;color:#fff;box-shadow:0 24px 44px -34px rgba(11,18,32,.9)}\n.cns-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}\n.host{display:flex;align-items:center;gap:8px}\n.host .nm{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:500;letter-spacing:-.02em}\n.host .cp{color:#7f93b3;font-size:13px}\n.pwr{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:500;color:#6ee7b7;border:1px solid rgba(110,231,183,.28);background:rgba(16,185,129,.12);border-radius:999px;padding:3px 9px 3px 7px}\n.pwr .dot{width:5px;height:5px;border-radius:50%;background:#34d399}\n.pwr.off{color:#cbd5e1;border-color:rgba(203,213,225,.22);background:rgba(148,163,184,.12)}\n.pwr.off .dot{background:#94a3b8}\n.cns-meta{font-size:11.5px;color:#8da2c2;margin-top:5px}\n.cns-fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 18px;margin-top:18px;padding-top:16px;border-top:1px solid rgba(255,255,255,.09)}\n.f label{display:block;font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:#7f93b3;margin-bottom:3px}\n.f .v{font-size:12.5px;color:#e8eefb}\n.f .v.mono{font-size:12.5px;letter-spacing:-.02em}\n.f .v .ok{color:#6ee7b7}\n.cns-actions{display:flex;align-items:center;gap:8px;margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,.09)}\n.b-dark{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;border-radius:8px;font-size:12px;font-weight:600;background:#fff;color:#0b1220}\n.b-ghost{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 11px;border-radius:8px;font-size:12px;font-weight:500;color:#dbe5f5;border:1px solid rgba(255,255,255,.16)}\n.b-ghost:hover{background:rgba(255,255,255,.06)}\n.cns-actions .spacer{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:11px;color:#7f93b3}\n\n/* operational rows */\n.ops{background:#fff;border:1px solid var(--border);border-radius:var(--r-card);margin-top:14px;overflow:hidden}\n.op{display:grid;grid-template-columns:150px minmax(0,1fr) auto;align-items:center;gap:16px;padding:12px 16px;border-bottom:1px solid var(--border-soft)}\n.op:last-child{border-bottom:0}\n.op .k{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:#334155}\n.op .k i{font-size:14px;color:var(--muted-2)}\n.op .v{font-size:12.5px;color:#475569;display:flex;align-items:center;gap:9px;flex-wrap:wrap}\n.op .v .mono{color:var(--muted);font-size:11.5px}\n.op .a{font-size:12px;font-weight:600;color:var(--accent);display:inline-flex;align-items:center;gap:5px;white-space:nowrap}\n.tag{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;padding:2px 7px;border-radius:999px;border:1px solid}\n.tag.ok{color:var(--success);background:var(--success-bg);border-color:#d1fae5}\n.tag.warn{color:var(--warning);background:var(--warning-bg);border-color:#fde68a}\n.tag.neu{color:#475569;background:var(--surface-2);border-color:var(--border)}\n\n/* services table */\n.panel{background:#fff;border:1px solid var(--border);border-radius:var(--r-card);margin-top:14px;overflow:hidden}\n.panel-hd{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--border)}\n.panel-hd h2{font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:700;letter-spacing:-.02em}\n.panel-hd .n{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--muted);margin-left:6px}\n.panel-hd a{font-size:12px;font-weight:500;color:var(--muted);display:inline-flex;align-items:center;gap:5px}\ntable{width:100%;border-collapse:collapse}\nthead th{font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:#94a3b8;font-weight:600;text-align:left;padding:8px 16px;background:var(--surface);border-bottom:1px solid var(--border)}\ntbody td{padding:11px 16px;border-bottom:1px solid var(--border-soft);font-size:12.5px;color:#334155;vertical-align:middle}\ntbody tr:last-child td{border-bottom:0}\ntbody tr.pick{background:var(--accent-wash)}\n.svc{display:flex;flex-direction:column;gap:1px}\n.svc .h{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text);display:flex;align-items:center;gap:6px}\n.svc .h i{font-size:12px;color:var(--accent)}\n.svc .m{font-size:11px;color:var(--muted-2)}\n.st{display:inline-flex;align-items:center;gap:6px;font-size:12px}\n.st .dot{width:6px;height:6px;border-radius:50%;background:#10b981}\n.st.off .dot{background:#cbd5e1}\n.st.off{color:var(--muted)}\n.right{text-align:right}\n.score{display:inline-flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:12px}\n.score .b{width:34px;height:3px;border-radius:2px;background:#e2e8f0;position:relative;overflow:hidden}\n.score .b i{position:absolute;left:0;top:0;bottom:0;display:block}\n.muted{color:var(--muted)}\n.tiny{font-size:11px;color:var(--muted-2)}\n\n/* rail */\n.rail{display:flex;flex-direction:column;gap:14px}\n.card{background:#fff;border:1px sol