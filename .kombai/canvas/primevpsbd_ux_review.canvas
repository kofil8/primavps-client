      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n:root{\n  --page:#ffffff; --surface:#f8fafc; --surface-2:#f1f5f9;\n  --ink:#0b1220; --ink-2:#151d30;\n  --border:#e2e8f0; --border-soft:#eef2f7; --border-strong:#cbd5e1;\n  --text:#0f172a; --muted:#64748b; --muted-2:#94a3b8;\n  --accent:#2563eb; --accent-hover:#1d4ed8; --accent-subtle:#eff6ff; --accent-line:#c7d9fd; --accent-wash:#f6f9ff;\n  --success:#047857; --success-bg:#ecfdf5; --warning:#b45309;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:#fff;color:var(--text);font-family:'Inter',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.55;-webkit-font-smoothing:antialiased}\na{color:inherit;text-decoration:none}\nbutton{font:inherit;color:inherit;background:none;border:0;cursor:pointer}\ni[class^=\"icon-\"]{font-size:15px;line-height:1;display:inline-block;vertical-align:-2px}\n.display{font-family:'Plus Jakarta Sans','Inter',sans-serif;letter-spacing:-.03em}\n.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;letter-spacing:-.01em}\n.wrap{max-width:1320px;margin:0 auto;padding:0 32px}\n\n/* header */\n.hdr{background:#fff;border-bottom:1px solid var(--border);position:relative;z-index:2}\n.hdr-in{display:flex;align-items:center;justify-content:space-between;height:64px;gap:24px}\n.hdr-left{display:flex;align-items:center;gap:30px}\n.brand{font-family:'Plus Jakarta Sans',sans-serif;font-size:19px;font-weight:800;letter-spacing:-.035em}\n.nav{display:flex;gap:2px}\n.nav a{display:flex;align-items:center;gap:5px;padding:7px 10px;border-radius:8px;font-size:13.5px;font-weight:500;color:#334155}\n.nav a i{font-size:13px;color:var(--muted-2)}\n.hdr-right{display:flex;align-items:center;gap:12px}\n.pill-ok{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;color:var(--success);background:var(--success-bg);border:1px solid #d1fae5;border-radius:999px;padding:4px 10px 4px 8px}\n.dot{width:6px;height:6px;border-radius:50%;background:#10b981;flex:none}\n.hdr-call{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:#334155}\n.hdr-call i{color:var(--muted-2)}\n.lang{border:1px solid var(--border);border-radius:8px;padding:4px 8px;font-size:12px;color:#334155;background:#fff}\n.cur{display:inline-flex;border:1px solid var(--border);border-radius:8px;overflow:hidden;font-size:12px}\n.cur b{background:var(--accent);color:#fff;padding:4px 8px;font-weight:500}\n.cur span{padding:4px 8px;color:var(--muted)}\n.signin{font-size:13px;font-weight:500;color:#334155}\n.hdr-btn{background:var(--ink);color:#fff;font-size:13px;font-weight:600;padding:8px 14px;border-radius:9px}\n\n/* hero */\n.hero{background:linear-gradient(180deg,#f6f9ff 0%,#ffffff 78%);border-bottom:1px solid var(--border)}\n.hero-in{display:grid;grid-template-columns:minmax(0,1fr) 560px;gap:56px;align-items:center;padding:54px 0 52px}\nh1{font-family:'Plus Jakarta Sans',sans-serif;font-size:44px;font-weight:800;line-height:1.07;letter-spacing:-.04em}\nh1 span{color:var(--accent)}\n.hero p{font-size:15px;color:var(--muted);margin-top:16px;max-width:520px}\n.hero-trust{display:flex;align-items:center;gap:10px;margin-top:22px;flex-wrap:wrap}\n.mark{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;border:1px solid var(--border);border-radius:8px;background:#fff;font-size:12px;font-weight:600}\n.mark .lg{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-style:italic;font-size:12px;letter-spacing:-.02em}\n.trust-txt{font-size:12px;color:var(--muted)}\n\n/* choice */\n.choice{background:#fff;border:1px solid var(--border);border-radius:18px;box-shadow:0 24px 48px -34px rgba(15,23,42,.4);overflow:hidden}\n.ch-hd{padding:13px 18px;border-bottom:1px solid var(--border);background:var(--surface);display:flex;align-items:center;justify-content:space-between}\n.ch-hd span{font-size:11.5px;font-weight:600;color:var(--muted);letter-spacing:.03em;text-transform:uppercase}\n.ch-hd em{font-style:normal;font-size:11.5px;color:var(--muted-2)}\n.ch-row{display:block;padding:16px 18px;border-bottom:1px solid var(--border-soft)}\n.ch-row:last-child{border-bottom:0}\n.ch-top{display:flex;align-items:center;justify-content:space-between;gap:12px}\n.ch-name{font-family:'Plus Jakarta Sans',sans-serif;font-size:16px;font-weight:700;letter-spacing:-.02em}\n.ch-go{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--accent)}\n.ch-row.primary .ch-go{background:var(--accent);color:#fff;padding:6px 11px;border-radius:8px}\n.ch-facts{display:flex;gap:18px;margin-top:8px;flex-wrap:wrap}\n.cf{font-size:11.5px;color:var(--muted)}\n.cf b{color:#334155;font-weight:500}\n\n/* sections */\n.sec{padding:64px 0;border-bottom:1px solid var(--border)}\n.sec.alt{background:var(--surface)}\n.sec-hd{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:26px}\nh2{font-family:'Plus Jakarta Sans',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.035em}\n.sec-hd p{font-size:13.5px;color:var(--muted);margin-top:6px;max-width:560px}\n.sec-hd .link{font-size:12.5px;font-weight:600;color:var(--accent);display:inline-flex;align-items:center;gap:6px;white-space:nowrap}\n\n/* plans */\n.plans{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n.pl{background:#fff;border:1px solid var(--border);border-radius:16px;overflow:hidden}\n.pl-hd{display:flex;align-items:baseline;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border)}\n.pl-hd h3{font-family:'Plus Jakarta Sans',sans-serif;font-size:14.5px;font-weight:700;letter-spacing:-.02em}\n.pl-hd span{font-size:11.5px;color:var(--muted-2)}\n.pl-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:14px;padding:11px 16px;border-bottom:1px solid var(--border-soft)}\n.pl-row:last-child{border-bottom:0}\n.pl-name{font-size:13px;font-weight:600}\n.pl-spec{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted);margin-top:2px}\n.pl-price{font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;text-align:right;white-space:nowrap}\n.pl-price small{font-size:10.5px;color:var(--muted-2);font-weight:400}\n.stock{font-size:10.5px;color:var(--success);text-align:right;white-space:nowrap}\n.stock.low{color:var(--warning)}\n.pl-ft{padding:11px 16px;background:var(--surface);border-top:1px solid var(--border);font-size:11.5px;color:var(--muted);display:flex;justify-content:space-between;gap:12px}\n\n/* regions + local */\n.locals{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:24px;align-items:start}\n.tbl{background:#fff;border:1px solid var(--border);border-radius:16px;overflow:hidden}\ntable{width:100%;border-collapse:collapse}\nthead th{font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:#94a3b8;font-weight:600;text-align:left;padding:10px 16px;background:var(--surface);border-bottom:1px solid var(--border)}\ntbody td{padding:12px 16px;border-bottom:1px solid var(--border-soft);font-size:12.5px;color:#334155;vertical-align:top}\ntbody tr:last-child td{border-bottom:0}\ntd .prod{font-size:12.5px;font-weight:600;color:var(--text)}\ntd .sub{font-size:11px;color:var(--muted-2);margin-top:1px}\n.local-card{background:#fff;border:1px solid var(--border);border-radius:16px;padding:4px 16px}\n.lrow{display:grid;grid-template-columns:96px minmax(0,1fr);gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid var(--border-soft)}\n.lrow:last-child{border-bottom:0}\n.lk{font-size:11.5px;color:var(--muted);font-weight:500}\n.lv{display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n.mark.sm{height:26px;padding:0 8px;font-size:11px}\n\n/* evidence */\n.evidence{background:var(--ink);color:#fff;border-bottom:1px solid #0b1220}\n.ev-in{display:grid;grid-template-columns:340px minmax(0,1fr);gap:44px;align-items:center}\n.evidence h2{color:#fff;font-size:24px}\n.evidence p{font-size:13.5px;color:#93a8c6;margin-top:10px}\n.tools{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}\n.tool{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 11px;border-radius:8px;border:1px solid rgba(255,255,255,.18);font-size:12px;color:#e8eefb}\n.tool i{font-size:13px;color:#8da2c2}\n.rec{background:var(--ink-2);border:1px solid rgba(255,255,255,.1);border-radius:14px;overflow:hidden}\n.rec-hd{display:flex;align-items:center;justify-content:space-between;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,.1)}\n.rec-hd .h{font-family:'JetBrains Mono',monospace;font-size:12px;color:#e8eefb}\n.rec-hd .chip{font-size:10.5px;color:#93a8c6;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:2px 8px}\n.rec-bd{display:grid;grid-template-columns:1fr 1fr;gap:0}\n.rf{padding:10px 16px;border-bottom:1px solid rgba(255,255,255,.07);border-right:1px solid rgba(255,255,255,.07)}\n.rf label{display:block;font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:#7f93b3;margin-bottom:2px}\n.rf .v{font-family:'JetBrains Mono',monospace;font-size:12px;color:#e8eefb}\n.rf .v.ok{color:#6ee7b7}\n.rec-ft{padding:10px 16px;font-size:11px;color:#7f93b3;display:flex;justify-content:space-between}\n\n/* proof */\n.proof{display:grid;grid-template-columns:repeat(2,1fr) 300px;gap:20px;align-items:start}\n.quote{border:1px solid var(--border);border-radius:16px;padding:18px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}\n.quote p{font-size:13.5px;color:#334155;line-height:1.6}\n.who{display:flex;align-items:center;gap:10px;margin-top:16px}\n.av{width:32px;height:32px;border-radius:50%;background:var(--surface-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#475569;font-family:'Plus Jakarta Sans',sans-serif}\n.who .n{font-size:12.5px;font-weight:600}\n.who .r{font-size:11.5px;color:var(--muted)}\n.figures{border-radius:16px;background:var(--accent-wash);border:1px solid var(--accent-line);padding:18px;display:flex;flex-direction:column;justify-content:center;gap:16px}\n.fig .num{font-family:'Plus Jakarta Sans',sans-serif;font-size:26px;font-weight:800;letter-spacing:-.035em;color:var(--accent-hover)}\n.fig .lb{font-size:11.5px;color:#475569;margin-top:1px}\n\n/* footer */\n.ftr{background:#fff;padding:40px 0 28px}\n.ftr-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;padding-bottom:26px;border-bottom:1px solid var(--border)}\n.ftr-top h4{font-size:11.5px;font-weight:600;color:var(--muted);margin-bottom:10px}\n.ftr-top a{display:block;font-size:12.5px;color:#334155;padding:3px 0}\n.ftr-brand p{font-size:12.5px;color:var(--muted);margin-top:8px;max-width:300px}\n.ftr-bot{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:18px}\n.ftr-bot .l{display:flex;align-items:center;gap:12px;font-size:11.5px;color:var(--muted-2)}\n.ftr-bot .r{display:flex;align-items:center;gap:8px}\n</style>\n<header class=\"hdr\" data-kid=\"1\" data-name=\"site header\">\n<div class=\"hdr-in wrap\" data-kid=\"1-1\" data-name=\"header inner bar\">\n<div class=\"hdr-left\" data-kid=\"1-1-1\" data-name=\"header left group with brand and nav\">\n<span class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"site brand name\">primevpsbd</span>\n<nav class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"servers nav link with dropdown\">Servers <i class=\"icon-chevron-down\" data-kid=\"1-1-1-2-1-1\" data-name=\"dropdown chevron icon\"></i></a>\n<a data-kid=\"1-1-1-2-2\" data-name=\"network nav link\">Network</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"tools nav link\">Tools</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"status nav link\">Status</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"docs nav link\">Docs</a>\n</nav>\n</div>\n<div class=\"hdr-right\" data-kid=\"1-1-2\" data-name=\"header right group with status and actions\">\n<span class=\"pill-ok\" data-kid=\"1-1-2-1\" data-name=\"system status indicator pill\"><span class=\"dot\" data-kid=\"1-1-2-1-1\" data-name=\"status indicator dot\"></span>All systems normal</span>\n<span class=\"hdr-call mono\" data-kid=\"1-1-2-2\" data-name=\"contact phone number\"><i class=\"icon-phone\" data-kid=\"1-1-2-2-1\" data-name=\"phone icon\"></i>+880 9606-PRIME</span>\n<span class=\"lang mono\" data-kid=\"1-1-2-3\" data-name=\"language label badge\">EN / বাংলা</span>\n<span class=\"cur mono\" data-kid=\"1-1-2-4\" data-name=\"currency switcher control\"><b data-kid=\"1-1-2-4-1\" data-name=\"active BDT currency option\">৳ BDT</b><span data-kid=\"1-1-2-4-2\" data-name=\"USD currency option\">$ USD</span></span>\n<span class=\"signin\" data-kid=\"1-1-2-5\" data-name=\"sign in link\">Sign in</span>\n<span class=\"hdr-btn\" data-kid=\"1-1-2-6\" data-name=\"client area call-to-action button\">Client area</span>\n</div>\n</div>\n</header>\n<section class=\"hero\" data-kid=\"2\" data-name=\"hero section\">\n<div class=\"hero-in wrap\" data-kid=\"2-1\" data-name=\"hero inner layout\">\n<div data-kid=\"2-1-1\" data-name=\"hero copy column\">\n<h1 data-kid=\"2-1-1-1\" data-name=\"hero headline\">Your server is in the US.<br data-kid=\"2-1-1-1-1\" data-name=\"line break\"/><span data-kid=\"2-1-1-1-2\" data-name=\"hero highlighted tagline span\">Your engineers are in Dhaka.</span></h1>\n<p data-kid=\"2-1-1-2\" data-name=\"hero description text\">Static residential IPs from AT&amp;T, Comcast and Verizon on KVM, plus NVMe cloud instances. Provisioned in under 90 seconds, billed in taka.</p>\n<div class=\"hero-trust\" data-kid=\"2-1-1-3\" data-name=\"hero trust indicators row\">\n<span class=\"mark\" data-kid=\"2-1-1-3-1\" data-name=\"payment badge for bKash\"><span class=\"lg\" data-kid=\"2-1-1-3-1-1\" data-name=\"bKash logo text\" style=\"color:#e2136e\">bKash</span></span>\n<span class=\"mark\" data-kid=\"2-1-1-3-2\" data-name=\"payment badge for Nagad\"><span class=\"lg\" data-kid=\"2-1-1-3-2-1\" data-name=\"Nagad logo text\" style=\"color:#f6921e\">Nagad</span></span>\n<span class=\"mark\" data-kid=\"2-1-1-3-3\" data-name=\"payment badge for Rocket\"><span class=\"lg\" data-kid=\"2-1-1-3-3-1\" data-name=\"Rocket logo text\" style=\"color:#8e2a8e\">Rocket</span></span>\n<span class=\"mark\" data-kid=\"2-1-1-3-4\" data-name=\"payment badge for card\"><i class=\"icon-credit-card\" data-kid=\"2-1-1-3-4-1\" data-name=\"credit card icon\"></i> Card</span>\n<span class=\"trust-txt\" data-kid=\"2-1-1-3-5\" data-name=\"WhatsApp support trust note\">Operations desk on WhatsApp, 24/7</span>\n</div>\n</div>\n<div class=\"choice\" data-kid=\"2-1-2\" data-name=\"server type choice card\">\n<div class=\"ch-hd\" data-kid=\"2-1-2-1\" data-name=\"choice card header\"><span data-kid=\"2-1-2-1-1\" data-name=\"choice card header title\">Choose a server type</span><em data-kid=\"2-1-2-1-2\" data-name=\"choice card billing note\">Both billed monthly</em></div>\n<a class=\"ch-row primary\" data-kid=\"2-1-2-2\" data-name=\"residential ISP VPS choice row\">\n<div class=\"ch-top\" data-kid=\"2-1-2-2-1\" data-name=\"residential VPS row top\">\n<span class=\"ch-name\" data-kid=\"2-1-2-2-1-1\" data-name=\"residential VPS product name\">Residential ISP VPS</span>\n<span class=\"ch-go\" data-kid=\"2-1-2-2-1-2\" data-name=\"view plans call-to-action\">View plans <i class=\"icon-arrow-right\" data-kid=\"2-1-2-2-1-2-1\" data-name=\"arrow right icon\"></i></span>\n</div>\n<div class=\"ch-facts\" data-kid=\"2-1-2-2-2\" data-name=\"residential VPS facts row\">\n<span class=\"cf\" data-kid=\"2-1-2-2-2-1\" data-name=\"route fact item\">Route <b data-kid=\"2-1-2-2-2-1-1\" data-name=\"route ISP names\">AT&amp;T, Comcast, Verizon, Spectrum</b></span>\n<span class=\"cf\" data-kid=\"2-1-2-2-2-2\" data-name=\"IP fact item\">IP <b data-kid=\"2-1-2-2-2-2-1\" data-name=\"IP type value\">Static residential</b></span>\n<span class=\"cf\" data-kid=\"2-1-2-2-2-3\" data-name=\"Windows fact item\">Windows <b data-kid=\"2-1-2-2-2-3-1\" data-name=\"Windows version value\">10 or 11 Pro</b></span>\n</div>\n</a>\n<a class=\"ch-row\" data-kid=\"2-1-2-3\" data-name=\"cloud VPS choice row\">\n<div class=\"ch-top\" data-kid=\"2-1-2-3-1\" data-name=\"cloud VPS row top\">\n<span class=\"ch-name\" data-kid=\"2-1-2-3-1-1\" data-name=\"cloud VPS product name\">Cloud VPS</span>\n<span class=\"ch-go\" data-kid=\"2-1-2-3-1-2\" data-name=\"configure call-to-action\">Configure <i class=\"icon-arrow-right\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"arrow right icon\"></i></span>\n</div>\n<div class=\"ch-facts\" data-kid=\"2-1-2-3-2\" data-name=\"cloud VPS facts row\">\n<span class=\"cf\" data-kid=\"2-1-2-3-2-1\" data-name=\"compute fact item\">Compute <b data-kid=\"2-1-2-3-2-1-1\" data-name=\"compute value\">1–16 vCPU, 2–64 GB</b></span>\n<span class=\"cf\" data-kid=\"2-1-2-3-2-2\" data-name=\"storage fact item\">Storage <b data-kid=\"2-1-2-3-2-2-1\" data-name=\"storage value\">NVMe RAID-1</b></span>\n<span class=\"cf\" data-kid=\"2-1-2-3-2-3\" data-name=\"regions fact item\">Regions <b data-kid=\"2-1-2-3-2-3-1\" data-name=\"regions value\">Dallas, Ashburn, Dhaka</b></span>\n</div>\n</a>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"3\" data-name=\"plans section\">\n<div class=\"wrap\" data-kid=\"3-1\" data-name=\"plans content wrapper\">\n<div class=\"sec-hd\" data-kid=\"3-1-1\" data-name=\"plans section header\">\n<div data-kid=\"3-1-1-1\" data-name=\"plans header text group\">\n<h2 data-kid=\"3-1-1-1-1\" data-name=\"plans heading\">Plans</h2>\n<p data-kid=\"3-1-1-1-2\" data-name=\"plans section description\">Every plan is a dedicated KVM slice with full administrator access and one dedicated IPv4 address.</p>\n</div>\n<a class=\"link\" data-kid=\"3-1-1-2\" data-name=\"compare specifications link\">Compare all specifications <i class=\"icon-arrow-right\" data-kid=\"3-1-1-2-1\" data-name=\"arrow right icon\"></i></a>\n</div>\n<div class=\"plans\" data-kid=\"3-1-2\" data-name=\"plans grid\">\n<div class=\"pl\" data-kid=\"3-1-2-1\" data-name=\"residential ISP plan card\">\n<div class=\"pl-hd\" data-kid=\"3-1-2-1-1\" data-name=\"residential plan card header\"><h3 data-kid=\"3-1-2-1-1-1\" data-name=\"residential plan card title\">Residential ISP</h3><span data-kid=\"3-1-2-1-1-2\" data-name=\"residential plan badge\">Clean IP included</span></div>\n<div class=\"pl-row\" data-kid=\"3-1-2-1-2\" data-name=\"starter survey VPS plan row\">\n<div data-kid=\"3-1-2-1-2-1\" data-name=\"starter plan specs group\"><div class=\"pl-name\" data-kid=\"3-1-2-1-2-1-1\" data-name=\"starter plan name\">Starter Survey VPS</div><div class=\"pl-spec\" data-kid=\"3-1-2-1-2-1-2\" data-name=\"starter plan specs\">2 vCPU · 4 GB · 45 GB</div></div>\n<div class=\"stock\" data-kid=\"3-1-2-1-2-2\" data-name=\"starter plan stock count\">8 in stock</div>\n<div class=\"pl-price\" data-kid=\"3-1-2-1-2-3\" data-name=\"starter plan price\">৳2,999<small data-kid=\"3-1-2-1-2-3-1\" data-name=\"starter billing period\">/mo</small></div>\n</div>\n<div class=\"pl-row\" data-kid=\"3-1-2-1-3\" data-name=\"pro survey VPS plan row\">\n<div data-kid=\"3-1-2-1-3-1\" data-name=\"pro plan specs group\"><div class=\"pl-name\" data-kid=\"3-1-2-1-3-1-1\" data-name=\"pro plan name\">Pro Survey VPS</div><div class=\"pl-spec\" data-kid=\"3-1-2-1-3-1-2\" data-name=\"pro plan specs\">4 vCPU · 6 GB · 60 GB</div></div>\n<div class=\"stock\" data-kid=\"3-1-2-1-3-2\" data-name=\"pro plan stock count\">5 in stock</div>\n<div class=\"pl-price\" data-kid=\"3-1-2-1-3-3\" data-name=\"pro plan price\">৳3,799<small data-kid=\"3-1-2-1-3-3-1\" data-name=\"pro billing period\">/mo</small></div>\n</div>\n<div class=\"pl-row\" data-kid=\"3-1-2-1-4\" data-name=\"VIP fresh ISP VPS plan row\">\n<div data-kid=\"3-1-2-1-4-1\" data-name=\"VIP plan specs group\"><div class=\"pl-name\" data-kid=\"3-1-2-1-4-1-1\" data-name=\"VIP plan name\">VIP Fresh ISP VPS</div><div class=\"pl-spec\" data-kid=\"3-1-2-1-4-1-2\" data-name=\"VIP plan specs\">4 vCPU · 8 GB · 80 GB</div></div>\n<div class=\"stock low\" data-kid=\"3-1-2-1-4-2\" data-name=\"VIP plan low stock count\">3 in stock</div>\n<div class=\"pl-price\" data-kid=\"3-1-2-1-4-3\" data-name=\"VIP plan price\">৳4,999<small data-kid=\"3-1-2-1-4-3-1\" data-name=\"VIP billing period\">/mo</small></div>\n</div>\n<div class=\"pl-ft\" data-kid=\"3-1-2-1-5\" data-name=\"residential plan card footer\"><span data-kid=\"3-1-2-1-5-1\" data-name=\"fresh IP note text\">Fresh, unused IP adds ৳500 per month</span><a data-kid=\"3-1-2-1-5-2\" data-name=\"view plans action link\">View plans <i class=\"icon-arrow-right\" data-kid=\"3-1-2-1-5-2-1\" data-name=\"arrow right icon\"></i></a></div>\n</div>\n<div class=\"pl\" data-kid=\"3-1-2-2\" data-name=\"cloud VPS plan card\">\n<div class=\"pl-hd\" data-kid=\"3-1-2-2-1\" data-name=\"cloud plan card header\"><h3 data-kid=\"3-1-2-2-1-1\" data-name=\"cloud plan card title\">Cloud VPS</h3><span data-kid=\"3-1-2-2-1-2\" data-name=\"cloud plan badge\">Datacenter IP</span></div>\n<div class=\"pl-row\" data-kid=\"3-1-2-2-2\" data-name=\"cloud starter plan row\">\n<div data-kid=\"3-1-2-2-2-1\" data-name=\"cloud starter specs group\"><div class=\"pl-name\" data-kid=\"3-1-2-2-2-1-1\" data-name=\"cloud starter plan name\">Starter</div><div class=\"pl-spec\" data-kid=\"3-1-2-2-2-1-2\" data-name=\"cloud starter plan specs\">1 vCPU · 2 GB · 30 GB</div></div>\n<div class=\"stock\" data-kid=\"3-1-2-2-2-2\" data-name=\"cloud starter availability\">Instant</div>\n<div class=\"pl-price\" data-kid=\"3-1-2-2-2-3\" data-name=\"cloud starter price\">৳950<small data-kid=\"3-1-2-2-2-3-1\" data-name=\"cloud starter billing period\">/mo</small></div>\n</div>\n<div class=\"pl-row\" data-kid=\"3-1-2-2-3\" data-name=\"cloud web plan row\">\n<div data-kid=\"3-1-2-2-3-1\" data-name=\"cloud web specs group\"><div class=\"pl-name\" data-kid=\"3-1-2-2-3-1-1\" data-name=\"cloud web plan name\">Web</div><div class=\"pl-spec\" data-kid=\"3-1-2-2-3-1-2\" data-name=\"cloud web plan specs\">2 vCPU · 4 GB · 80 GB</div></div>\n<div class=\"stock\" data-kid=\"3-1-2-2-3-2\" data-name=\"cloud web availability\">Instant</div>\n<div class=\"pl-price\" data-kid=\"3-1-2-2-3-3\" data-name=\"cloud web price\">৳1,845<small data-kid=\"3-1-2-2-3-3-1\" data-name=\"cloud web billing period\">/mo</small></div>\n</div>\n<div class=\"pl-row\" data-kid=\"3-1-2-2-4\" data-name=\"cloud app plan row\">\n<div data-kid=\"3-1-2-2-4-1\" data-name=\"cloud app specs group\"><div class=\"pl-name\" data-kid=\"3-1-2-2-4-1-1\" data-name=\"cloud app plan name\">App</div><div class=\"pl-spec\" data-kid=\"3-1-2-2-4-1-2\" data-name=\"cloud app plan specs\">4 vCPU · 8 GB · 160 GB</div></div>\n<div class=\"stock\" data-kid=\"3-1-2-2-4-2\" data-name=\"cloud app availability\">Instant</div>\n<div class=\"pl-price\" data-kid=\"3-1-2-2-4-3\" data-name=\"cloud app price\">৳3,545<small data-kid=\"3-1-2-2-4-3-1\" data-name=\"cloud app billing period\">/mo</small></div>\n</div>\n<div class=\"pl-ft\" data-kid=\"3-1-2-2-5\" data-name=\"cloud plan card footer\"><span data-kid=\"3-1-2-2-5-1\" data-name=\"cloud customization note text\">Up to 16 vCPU, 64 GB and 500 GB</span><a data-kid=\"3-1-2-2-5-2\" data-name=\"configure action link\">Configure <i class=\"icon-arrow-right\" data-kid=\"3-1-2-2-5-2-1\" data-name=\"arrow right icon\"></i></a></div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec alt\" data-kid=\"4\" data-name=\"regions and payment section\">\n<div class=\"wrap\" data-kid=\"4-1\" data-name=\"regions content wrapper\">\n<div class=\"sec-hd\" data-kid=\"4-1-1\" data-name=\"regions section header\">\n<div data-kid=\"4-1-1-1\" data-name=\"regions header text group\">\n<h2 data-kid=\"4-1-1-1-1\" data-name=\"regions heading\">Regions and payment</h2>\n<p data-kid=\"4-1-1-1-2\" data-name=\"regions section description\">Residential nodes sit in US carrier hotels. Cloud instances run in three regions, including Dhaka.</p>\n</div>\n<a class=\"link\" data-kid=\"4-1-1-2\" data-name=\"live network status link\"><i class=\"icon-chart-line\" data-kid=\"4-1-1-2-1\" data-name=\"chart line icon\"></i> Live network status</a>\n</div>\n<div class=\"locals\" data-kid=\"4-1-2\" data-name=\"regions layout grid\">\n<div class=\"tbl\" data-kid=\"4-1-2-1\" data-name=\"regions table container\">\n<table data-kid=\"4-1-2-1-1\" data-name=\"regions data table\">\n<thead data-kid=\"4-1-2-1-1-1\" data-name=\"table header section\">\n<tr data-kid=\"4-1-2-1-1-1-1\" data-name=\"table header row\">\n<th data-kid=\"4-1-2-1-1-1-1-1\" data-name=\"product column header\" style=\"width:170px\">Product</th>\n<th data-kid=\"4-1-2-1-1-1-1-2\" data-name=\"location column header\" style=\"width:210px\">Location</th>\n<th data-kid=\"4-1-2-1-1-1-1-3\" data-name=\"facility column header\">Facility and route</th>\n<th data-kid=\"4-1-2-1-1-1-1-4\" data-name=\"availability column header\" style=\"width:190px\">Available</th>\n</tr>\n</thead>\n<tbody data-kid=\"4-1-2-1-1-2\" data-name=\"table body rows\">\n<tr data-kid=\"4-1-2-1-1-2-1\" data-name=\"dallas residential ISP table row\">\n<td data-kid=\"4-1-2-1-1-2-1-1\" data-name=\"dallas residential product cell\"><div class=\"prod\" data-kid=\"4-1-2-1-1-2-1-1-1\" data-name=\"dallas residential product name\">Residential ISP</div><div class=\"sub\" data-kid=\"4-1-2-1-1-2-1-1-2\" data-name=\"dallas residential OS subtitle\">Windows VPS</div></td>\n<td data-kid=\"4-1-2-1-1-2-1-2\" data-name=\"dallas location cell\">Dallas, TX <span class=\"mono tiny\" data-kid=\"4-1-2-1-1-2-1-2-1\" data-name=\"dallas latency badge\">18 ms</span></td>\n<td data-kid=\"4-1-2-1-1-2-1-3\" data-name=\"dallas facility cell\">Infomart carrier hotel, AS7018 AT&amp;T Services</td>\n<td data-kid=\"4-1-2-1-1-2-1-4\" data-name=\"dallas availability cell\">AT&amp;T, Comcast, Verizon, Spectrum</td>\n</tr>\n<tr data-kid=\"4-1-2-1-1-2-2\" data-name=\"ashburn residential ISP table row\">\n<td data-kid=\"4-1-2-1-1-2-2-1\" data-name=\"ashburn residential product cell\"><div class=\"prod\" data-kid=\"4-1-2-1-1-2-2-1-1\" data-name=\"ashburn residential product name\">Residential ISP</div><div class=\"sub\" data-kid=\"4-1-2-1-1-2-2-1-2\" data-name=\"ashburn residential OS subtitle\">Windows VPS</div></td>\n<td data-kid=\"4-1-2-1-1-2-2-2\" data-name=\"ashburn location cell\">Ashburn, VA <span class=\"mono tiny\" data-kid=\"4-1-2-1-1-2-2-2-1\" data-name=\"ashburn latency badge\">22 ms</span></td>\n<td data-kid=\"4-1-2-1-1-2-2-3\" data-name=\"ashburn facility cell\">Equinix DC, AS7922 Comcast</td>\n<td data-kid=\"4-1-2-1-1-2-2-4\" data-name=\"ashburn availability cell\">AT&amp;T, Comcast, Verizon</td>\n</tr>\n<tr data-kid=\"4-1-2-1-1-2-3\" data-name=\"cloud US table row\">\n<td data-kid=\"4-1-2-1-1-2-3-1\" data-name=\"cloud US product cell\"><div class=\"prod\" data-kid=\"4-1-2-1-1-2-3-1-1\" data-name=\"cloud US product name\">Cloud VPS</div><div class=\"sub\" data-kid=\"4-1-2-1-1-2-3-1-2\" data-name=\"cloud US OS subtitle\">Linux and Windows</div></td>\n<td data-kid=\"4-1-2-1-1-2-3-2\" data-name=\"cloud US location cell\">Dallas, Ashburn <span class=\"mono tiny\" data-kid=\"4-1-2-1-1-2-3-2-1\" data-name=\"cloud US latency badge\">18–22 ms</span></td>\n<td data-kid=\"4-1-2-1-1-2-3-3\" data-name=\"cloud US facility cell\">KVM, 1 Gbps unmetered, NVMe RAID-1</td>\n<td data-kid=\"4-1-2-1-1-2-3-4\" data-name=\"cloud US availability cell\">Ubuntu, Debian, AlmaLinux, Windows</td>\n</tr>\n<tr data-kid=\"4-1-2-1-1-2-4\" data-name=\"dhaka cloud table row\">\n<td data-kid=\"4-1-2-1-1-2-4-1\" data-name=\"dhaka cloud product cell\"><div class=\"prod\" data-kid=\"4-1-2-1-1-2-4-1-1\" data-name=\"dhaka cloud product name\">Cloud VPS</div><div class=\"sub\" data-kid=\"4-1-2-1-1-2-4-1-2\" data-name=\"dhaka cloud OS subtitle\">Linux</div></td>\n<td data-kid=\"4-1-2-1-1-2-4-2\" data-name=\"dhaka location cell\">Dhaka <span class=\"mono tiny\" data-kid=\"4-1-2-1-1-2-4-2-1\" data-name=\"dhaka peering badge\">BDIX</span></td>\n<td data-kid=\"4-1-2-1-1-2-4-3\" data-name=\"dhaka facility cell\">Local peering, 1 Gbps</td>\n<td data-kid=\"4-1-2-1-1-2-4-4\" data-name=\"dhaka availability cell\">Ubuntu, Debian</td>\n</tr>\n</tbody>\n</table>\n<div data-kid=\"4-1-2-1-2\" data-name=\"table footnote text\" style=\"padding:11px 16px;border-top:1px solid var(--border);font-size:11px;color:var(--muted-2)\">Latency measured from the Dhaka office on 17 Nov 2026.</div>\n</div>\n<div class=\"local-card\" data-kid=\"4-1-2-2\" data-name=\"payment and local details card\">\n<div class=\"lrow\" data-kid=\"4-1-2-2-1\" data-name=\"payment row\">\n<div class=\"lk\" data-kid=\"4-1-2-2-1-1\" data-name=\"payment label\">Payment</div>\n<div class=\"lv\" data-kid=\"4-1-2-2-1-2\" data-name=\"payment methods value\">\n<span class=\"mark sm\" data-kid=\"4-1-2-2-1-2-1\" data-name=\"payment badge for bKash\"><span class=\"lg\" data-kid=\"4-1-2-2-1-2-1-1\" data-name=\"bKash logo text\" style=\"color:#e2136e\">bKash</span></span>\n<span class=\"mark sm\" data-kid=\"4-1-2-2-1-2-2\" data-name=\"payment badge for Nagad\"><span class=\"lg\" data-kid=\"4-1-2-2-1-2-2-1\" data-name=\"Nagad logo text\" style=\"color:#f6921e\">Nagad</span></span>\n<span class=\"mark sm\" data-kid=\"4-1-2-2-1-2-3\" data-name=\"payment badge for Rocket\"><span class=\"lg\" data-kid=\"4-1-2-2-1-2-3-1\" data-name=\"Rocket logo text\" style=\"color:#8e2a8e\">Rocket</span></span>\n<span class=\"mark sm\" data-kid=\"4-1-2-2-1-2-4\" data-name=\"payment badge for card\"><i class=\"icon-credit-card\" data-kid=\"4-1-2-2-1-2-4-1\" data-name=\"credit card icon\"></i> Card</span>\n</div>\n</div>\n<div class=\"lrow\" data-kid=\"4-1-2-2-2\" data-name=\"currency row\">\n<div class=\"lk\" data-kid=\"4-1-2-2-2-1\" data-name=\"currency label\">Currency</div>\n<div class=\"lv\" data-kid=\"4-1-2-2-2-2\" data-name=\"currency value\"><span data-kid=\"4-1-2-2-2-2-1\" data-name=\"currency note text\" style=\"font-size:12.5px\">Taka, with a dollar toggle. Invoices in BDT.</span></div>\n</div>\n<div class=\"lrow\" data-kid=\"4-1-2-2-3\" data-name=\"language row\">\n<div class=\"lk\" data-kid=\"4-1-2-2-3-1\" data-name=\"language label\">Language</div>\n<div class=\"lv\" data-kid=\"4-1-2-2-3-2\" data-name=\"language value\"><span class=\"mark sm mono\" data-kid=\"4-1-2-2-3-2-1\" data-name=\"language options badge\" style=\"font-weight:500\">English / বাংলা</span></div>\n</div>\n<div class=\"lrow\" data-kid=\"4-1-2-2-4\" data-name=\"support row\">\n<div class=\"lk\" data-kid=\"4-1-2-2-4-1\" data-name=\"support label\">Support</div>\n<div class=\"lv\" data-kid=\"4-1-2-2-4-2\" data-name=\"support value\">\n<a class=\"mark sm\" data-kid=\"4-1-2-2-4-2-1\" data-name=\"WhatsApp support link\"><i class=\"icon-message-circle\" data-kid=\"4-1-2-2-4-2-1-1\" data-name=\"message icon\" style=\"color:#047857\"></i> WhatsApp</a>\n<a class=\"mark sm\" data-kid=\"4-1-2-2-4-2-2\" data-name=\"phone number support link\"><i class=\"icon-phone\" data-kid=\"4-1-2-2-4-2-2-1\" data-name=\"phone icon\" style=\"color:#64748b\"></i> +880 9606-PRIME</a>\n</div>\n</div>\n<div class=\"lrow\" data-kid=\"4-1-2-2-5\" data-name=\"replacement row\">\n<div class=\"lk\" data-kid=\"4-1-2-2-5-1\" data-name=\"replacement label\">Replacement</div>\n<div class=\"lv\" data-kid=\"4-1-2-2-5-2\" data-name=\"replacement value\"><span data-kid=\"4-1-2-2-5-2-1\" data-name=\"replacement note text\" style=\"font-size:12.5px\">One free IP swap within 168 hours</span></div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec evidence\" data-kid=\"5\" data-name=\"evidence and diagnostics section\">\n<div class=\"ev-in wrap\" data-kid=\"5-1\" data-name=\"evidence section layout\">\n<div data-kid=\"5-1-1\" data-name=\"evidence copy column\">\n<h2 data-kid=\"5-1-1-1\" data-name=\"evidence heading\">Before you order</h2>\n<p data-kid=\"5-1-1-2\" data-name=\"evidence description text\">Run the same checks our team runs before handover. Each tool returns the fraud score, carrier and leak result for any IP.</p>\n<div class=\"tools\" data-kid=\"5-1-1-3\" data-name=\"tools list\">\n<a class=\"tool\" data-kid=\"5-1-1-3-1\" data-name=\"IP fraud checker tool link\"><i class=\"icon-shield-check\" data-kid=\"5-1-1-3-1-1\" data-name=\"shield check icon\"></i> IP fraud checker</a>\n<a class=\"tool\" data-kid=\"5-1-1-3-2\" data-name=\"WebRTC test tool link\"><i class=\"icon-wifi\" data-kid=\"5-1-1-3-2-1\" data-name=\"WiFi icon\"></i> WebRTC test</a>\n<a class=\"tool\" data-kid=\"5-1-1-3-3\" data-name=\"looking glass tool link\"><i class=\"icon-terminal\" data-kid=\"5-1-1-3-3-1\" data-name=\"terminal icon\"></i> Looking glass</a>\n<a class=\"tool\" data-kid=\"5-1-1-3-4\" data-name=\"status tool link\"><i class=\"icon-chart-line\" data-kid=\"5-1-1-3-4-1\" data-name=\"chart line icon\"></i> Status</a>\n</div>\n</div>\n<div class=\"rec\" data-kid=\"5-1-2\" data-name=\"IP check record card\">\n<div class=\"rec-hd\" data-kid=\"5-1-2-1\" data-name=\"record card header\">\n<span class=\"h\" data-kid=\"5-1-2-1-1\" data-name=\"record hostname\">dal-att-04.primevpsbd.com</span>\n<span class=\"chip\" data-kid=\"5-1-2-1-2\" data-name=\"sample record badge\">Sample record</span>\n</div>\n<div class=\"rec-bd\" data-kid=\"5-1-2-2\" data-name=\"record body grid\">\n<div class=\"rf\" data-kid=\"5-1-2-2-1\" data-name=\"IPv4 field\"><label data-kid=\"5-1-2-2-1-1\" data-name=\"IPv4 label\">IPv4</label><div class=\"v\" data-kid=\"5-1-2-2-1-2\" data-name=\"IPv4 value\">108.204.142.88</div></div>\n<div class=\"rf\" data-kid=\"5-1-2-2-2\" data-name=\"autonomous system field\" style=\"border-right:0\"><label data-kid=\"5-1-2-2-2-1\" data-name=\"autonomous system label\">Autonomous system</label><div class=\"v\" data-kid=\"5-1-2-2-2-2\" data-name=\"autonomous system value\">AS7018 AT&amp;T Services</div></div>\n<div class=\"rf\" data-kid=\"5-1-2-2-3\" data-name=\"IPQS score field\"><label data-kid=\"5-1-2-2-3-1\" data-name=\"IPQS score label\">IPQS score</label><div class=\"v ok\" data-kid=\"5-1-2-2-3-2\" data-name=\"IPQS score value\">0 / 100</div></div>\n<div class=\"rf\" data-kid=\"5-1-2-2-4\" data-name=\"proxy or VPN field\" style=\"border-right:0\"><label data-kid=\"5-1-2-2-4-1\" data-name=\"proxy or VPN label\">Proxy or VPN</label><div class=\"v\" data-kid=\"5-1-2-2-4-2\" data-name=\"proxy or VPN value\">Not detected</div></div>\n<div class=\"rf\" data-kid=\"5-1-2-2-5\" data-name=\"DNS leak field\"><label data-kid=\"5-1-2-2-5-1\" data-name=\"DNS leak label\">DNS leak</label><div class=\"v\" data-kid=\"5-1-2-2-5-2\" data-name=\"DNS leak value\">None detected</div></div>\n<div class=\"rf\" data-kid=\"5-1-2-2-6\" data-name=\"WebRTC leak field\" style=\"border-right:0\"><label data-kid=\"5-1-2-2-6-1\" data-name=\"WebRTC leak label\">WebRTC leak</label><div class=\"v\" data-kid=\"5-1-2-2-6-2\" data-name=\"WebRTC leak value\">No public IP exposed</div></div>\n<div class=\"rf\" data-kid=\"5-1-2-2-7\" data-name=\"timezone field\" style=\"border-bottom:0\"><label data-kid=\"5-1-2-2-7-1\" data-name=\"timezone label\">Timezone</label><div class=\"v\" data-kid=\"5-1-2-2-7-2\" data-name=\"timezone value\">America/Chicago</div></div>\n<div class=\"rf\" data-kid=\"5-1-2-2-8\" data-name=\"checked timestamp field\" style=\"border-bottom:0;border-right:0\"><label data-kid=\"5-1-2-2-8-1\" data-name=\"checked timestamp label\">Checked</label><div class=\"v\" data-kid=\"5-1-2-2-8-2\" data-name=\"checked timestamp value\">17 Nov 2026, 12:41</div></div>\n</div>\n<div class=\"rec-ft\" data-kid=\"5-1-2-3\" data-name=\"record footer\"><span data-kid=\"5-1-2-3-1\" data-name=\"route label text\">Residential route</span><span data-kid=\"5-1-2-3-2\" data-name=\"uptime label text\">Uptime, 90 days: 99.98%</span></div>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"6\" data-name=\"customers and proof section\">\n<div class=\"wrap\" data-kid=\"6-1\" data-name=\"customers section wrapper\">\n<div class=\"sec-hd\" data-kid=\"6-1-1\" data-name=\"customers section header\">\n<div data-kid=\"6-1-1-1\" data-name=\"customers header text group\">\n<h2 data-kid=\"6-1-1-1-1\" data-name=\"customers heading\">Customers</h2>\n<p data-kid=\"6-1-1-1-2\" data-name=\"customers section description\">Two of the agencies and freelancers currently running residential nodes with us.</p>\n</div>\n</div>\n<div class=\"proof\" data-kid=\"6-1-2\" data-name=\"proof layout grid\">\n<div class=\"quote\" data-kid=\"6-1-2-1\" data-name=\"first customer quote card\">\n<p data-kid=\"6-1-2-1-1\" data-name=\"first customer quote text\">“The AT&amp;T nodes have held a zero fraud score for eight months. When one Comcast IP drifted to 22, the swap was finished before I finished the ticket.”</p>\n<div class=\"who\" data-kid=\"6-1-2-1-2\" data-name=\"first customer attribution\">\n<span class=\"av\" data-kid=\"6-1-2-1-2-1\" data-name=\"first customer avatar initials\">RI</span>\n<div data-kid=\"6-1-2-1-2-2\" data-name=\"first customer identity group\"><div class=\"n\" data-kid=\"6-1-2-1-2-2-1\" data-name=\"first customer name\">Rafiqul Islam</div><div class=\"r\" data-kid=\"6-1-2-1-2-2-2\" data-name=\"first customer role\">Survey agency, Dhaka · 14 nodes</div></div>\n</div>\n</div>\n<div class=\"quote\" data-kid=\"6-1-2-2\" data-name=\"second customer quote card\">\n<p data-kid=\"6-1-2-2-1\" data-name=\"second customer quote text\">“Paying by bKash and having the RDP details in the same minute is what made me move. I do not have a card, and I did not want to wait for a reseller to reply.”</p>\n<div class=\"who\" data-kid=\"6-1-2-2-2\" data-name=\"second customer attribution\">\n<span class=\"av\" data-kid=\"6-1-2-2-2-1\" data-name=\"second customer avatar initials\">TH</span>\n<div data-kid=\"6-1-2-2-2-2\" data-name=\"second customer identity group\"><div class=\"n\" data-kid=\"6-1-2-2-2-2-1\" data-name=\"second customer name\">Tanvir Hossain</div><div class=\"r\" data-kid=\"6-1-2-2-2-2-2\" data-name=\"second customer role\">Freelance surveyor, Chattogram · 2 nodes</div></div>\n</div>\n</div>\n<div class=\"figures\" data-kid=\"6-1-2-3\" data-name=\"statistics figures card\">\n<div class=\"fig\" data-kid=\"6-1-2-3-1\" data-name=\"uptime stat\"><div class=\"num mono\" data-kid=\"6-1-2-3-1-1\" data-name=\"uptime stat value\">99.98%</div><div class=\"lb\" data-kid=\"6-1-2-3-1-2\" data-name=\"uptime stat label\">Uptime, 90-day rolling</div></div>\n<div class=\"fig\" data-kid=\"6-1-2-3-2\" data-name=\"median time to RDP stat\"><div class=\"num mono\" data-kid=\"6-1-2-3-2-1\" data-name=\"RDP time stat value\">68 s</div><div class=\"lb\" data-kid=\"6-1-2-3-2-2\" data-name=\"RDP time stat label\">Median time to RDP access</div></div>\n<div class=\"fig\" data-kid=\"6-1-2-3-3\" data-name=\"first reply stat\"><div class=\"num mono\" data-kid=\"6-1-2-3-3-1\" data-name=\"first reply stat value\">3 min</div><div class=\"lb\" data-kid=\"6-1-2-3-3-2\" data-name=\"first reply stat label\">Median first reply, operations desk</div></div>\n</div>\n</div>\n</div>\n</section>\n<footer class=\"ftr\" data-kid=\"7\" data-name=\"site footer\">\n<div class=\"wrap\" data-kid=\"7-1\" data-name=\"footer wrapper\">\n<div class=\"ftr-top\" data-kid=\"7-1-1\" data-name=\"footer top column grid\">\n<div class=\"ftr-brand\" data-kid=\"7-1-1-1\" data-name=\"footer brand group\">\n<span class=\"brand\" data-kid=\"7-1-1-1-1\" data-name=\"footer brand name\">primevpsbd</span>\n<p data-kid=\"7-1-1-1-2\" data-name=\"footer tagline text\">Residential ISP and cloud servers for Bangladeshi teams. Banani, Dhaka and Dallas, Texas.</p>\n</div>\n<div data-kid=\"7-1-1-2\" data-name=\"footer servers column\">\n<h4 data-kid=\"7-1-1-2-1\" data-name=\"footer servers heading\">Servers</h4>\n<a data-kid=\"7-1-1-2-2\" data-name=\"residential ISP footer link\">Residential ISP VPS</a>\n<a data-kid=\"7-1-1-2-3\" data-name=\"cloud VPS footer link\">Cloud VPS</a>\n<a data-kid=\"7-1-1-2-4\" data-name=\"reseller pricing footer link\">Reseller pricing</a>\n</div>\n<div data-kid=\"7-1-1-3\" data-name=\"footer tools column\">\n<h4 data-kid=\"7-1-1-3-1\" data-name=\"footer tools heading\">Tools</h4>\n<a data-kid=\"7-1-1-3-2\" data-name=\"IP fraud checker footer link\">IP fraud checker</a>\n<a data-kid=\"7-1-1-3-3\" data-name=\"WebRTC test footer link\">WebRTC test</a>\n<a data-kid=\"7-1-1-3-4\" data-name=\"looking glass footer link\">Looking glass</a>\n<a data-kid=\"7-1-1-3-5\" data-name=\"status footer link\">Status</a>\n</div>\n<div data-kid=\"7-1-1-4\" data-name=\"footer company column\">\n<h4 data-kid=\"7-1-1-4-1\" data-name=\"footer company heading\">Company</h4>\n<a data-kid=\"7-1-1-4-2\" data-name=\"contact footer link\">Contact</a>\n<a data-kid=\"7-1-1-4-3\" data-name=\"blog footer link\">Blog</a>\n<a data-kid=\"7-1-1-4-4\" data-name=\"terms footer link\">Terms</a>\n<a data-kid=\"7-1-1-4-5\" data-name=\"privacy footer link\">Privacy</a>\n</div>\n</div>\n<div class=\"ftr-bot\" data-kid=\"7-1-2\" data-name=\"footer bottom bar\">\n<div class=\"l\" data-kid=\"7-1-2-1\" data-name=\"footer left credentials\">\n<span class=\"mono\" data-kid=\"7-1-2-1-1\" data-name=\"copyright notice text\">© 2026 primevpsbd.com</span>\n<span data-kid=\"7-1-2-1-2\" data-name=\"APNIC NIR member badge\">APNIC NIR member</span>\n<span data-kid=\"7-1-2-1-3\" data-name=\"SSLCommerz payment badge\">SSLCommerz</span>\n</div>\n<div class=\"r\" data-kid=\"7-1-2-2\" data-name=\"footer right payment methods\">\n<span class=\"mark sm\" data-kid=\"7-1-2-2-1\" data-name=\"payment badge for bKash\"><span class=\"lg\" data-kid=\"7-1-2-2-1-1\" data-name=\"bKash logo text\" style=\"color:#e2136e\">bKash</span></span>\n<span class=\"mark sm\" data-kid=\"7-1-2-2-2\" data-name=\"payment badge for Nagad\"><span class=\"lg\" data-kid=\"7-1-2-2-2-1\" data-name=\"Nagad logo text\" style=\"color:#f6921e\">Nagad</span></span>\n<span class=\"mark sm\" data-kid=\"7-1-2-2-3\" data-name=\"payment badge for Rocket\"><span class=\"lg\" data-kid=\"7-1-2-2-3-1\" data-name=\"Rocket logo text\" style=\"color:#8e2a8e\">Rocket</span></span>\n<span class=\"mark sm\" data-kid=\"7-1-2-2-4\" data-name=\"payment badge for card\"><i class=\"icon-credit-card\" data-kid=\"7-1-2-2-4-1\" data-name=\"credit card icon\"></i> Card</span>\n</div>\n</div>\n</div>\n</footer>\n",
