0;color:#334155}\n\n.sup{background:var(--ink);border-radius:var(--r-card);padding:14px 16px;color:#fff}\n.sup h4{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:-.01em}\n.sup p{font-size:11.5px;color:#93a8c6;margin-top:3px}\n.sup-links{display:flex;gap:8px;margin-top:11px}\n.sup-links a{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;border-radius:8px;border:1px solid rgba(255,255,255,.16);font-size:11.5px;font-weight:500;color:#e8eefb}\n.sup-links a:first-child{background:rgba(16,185,129,.15);border-color:rgba(110,231,183,.3);color:#a7f3d0}\n</style>\n<header class=\"topbar\" data-kid=\"1\" data-name=\"client area top navigation bar\">\n<div class=\"tb-left\" data-kid=\"1-1\" data-name=\"top bar left brand group\">\n<span class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand wordmark\">primevpsbd</span>\n<span class=\"tb-sep\" data-kid=\"1-1-2\" data-name=\"vertical separator divider\"></span>\n<span class=\"tb-ws\" data-kid=\"1-1-3\" data-name=\"workspace section label\">Client area</span>\n</div>\n<div class=\"tb-right\" data-kid=\"1-2\" data-name=\"top bar right controls group\">\n<span class=\"lang mono\" data-kid=\"1-2-1\" data-name=\"language toggle button\">EN / বাংলা</span>\n<span class=\"cur mono\" data-kid=\"1-2-2\" data-name=\"currency selector group\"><b data-kid=\"1-2-2-1\" data-name=\"active currency option BDT\">৳ BDT</b><span data-kid=\"1-2-2-2\" data-name=\"alternative currency option USD\">$ USD</span></span>\n<span class=\"iconbtn\" data-kid=\"1-2-3\" data-name=\"notifications bell button\"><i class=\"icon-bell\" data-kid=\"1-2-3-1\" data-name=\"bell notification icon\"></i></span>\n<div class=\"who\" data-kid=\"1-2-4\" data-name=\"user account menu group\">\n<span class=\"av\" data-kid=\"1-2-4-1\" data-name=\"user avatar with initials\">AM</span>\n<span class=\"who-name\" data-kid=\"1-2-4-2\" data-name=\"user full name display\">Asif Mahmud</span>\n<i class=\"icon-